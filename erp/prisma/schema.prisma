// ============================================================
// DE'VYORA / CASA DE AURUM — ERP DATABASE
// ============================================================
//
// THE ERP'S OWN DATABASE. Nothing here reads or writes the Casa De
// Aurum website's database, and nothing in it mirrors the website's
// schema. The two are separate systems that will talk through an
// ERP API later:
//
//     ERP software -> ERP API -> Casa De Aurum backend -> website
//
// The only place the website is acknowledged at all is
// WebsiteProductMapping, which holds the website's identifier for a
// product beside the ERP's own. It is a mapping table on purpose:
// the website's ids never get into the Product Master, so the ERP
// can be read, migrated or rebuilt without the website existing.
//
// ── CONVENTIONS KEPT THROUGHOUT ──────────────────────────────────
//
// IDs are UUIDs, generated by the database, and permanent. A row's
// id is never reused and never changes, so a historical document
// can point at it for ever.
//
// MONEY is Decimal(14,2) and QUANTITY is Decimal(14,3). Never Float.
// A float cannot hold 0.1 exactly, and a stock balance that drifts
// by 0.0000001 per movement is a stock balance nobody can audit.
//
// DELETES ARE RESTRICTED, not cascaded, everywhere that history
// lives. Deleting a brand must not silently take its products, and
// deleting a product must not take the stock movements that explain
// where the stock went. The only cascades in this file are from a
// document to its OWN lines, where the lines have no meaning apart
// from the document.
//
// TIMESTAMPS: createdAt/updatedAt on anything a person edits.
// Append-only tables carry createdAt alone, because there is no
// such thing as updating one.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/erp-client"
}

/// The connection URL is NOT here. Prisma 7 moved it to
/// prisma.config.mjs, where it is read from ERP_DATABASE_URL --
/// a variable of the ERP's own, deliberately not DATABASE_URL, so
/// that having the website's environment loaded in the same shell
/// can never point an ERP migration at the website's database.
datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

/// WHAT A PRODUCT IS, COMMERCIALLY.
///
/// Out of stock is NOT here, deliberately. Whether something is on
/// the shelf is a fact about inventory at a warehouse on a date; it
/// changes several times a week without anybody deciding anything,
/// and it differs per warehouse. Writing it into the product would
/// mean a background job editing the Product Master all day, and
/// two warehouses disagreeing about one column.
///
/// Availability is derived: InventoryBalance.quantityOnHand, or the
/// v_product_availability view.
enum ProductStatus {
  /// On sale. The normal state.
  ACTIVE
  /// Temporarily withdrawn: not offered, not deleted, may return.
  /// The prototype's "Draft" — never yet published — is this plus
  /// a WebsiteProductMapping that has never synced.
  INACTIVE
  /// Retired for good. Never reorder, even at zero stock. This is
  /// the one that must never be confused with "out of stock":
  /// one is a product to buy more of, the other one not to.
  DISCONTINUED
}

/// The unit a quantity is counted in. Tile is bought and sold by
/// the box; area and pieces are properties OF a box, held on the
/// product, so one box is always one box in the ledger.
enum UnitOfMeasure {
  BOX
  PIECE
  SQFT
  SQM
  SET
}

/// WHAT A PRICE IS PER. Tile is quoted per square foot but moved
/// per box, and leaving that implicit is how a 15x error gets into
/// an order. Stated per product, next to the price itself.
enum PriceBasis {
  PER_BOX
  PER_PIECE
  PER_SQFT
  PER_SQM
}

/// Which way stock moved. Transfers are two entries, not one, so
/// each warehouse's own ledger stands on its own.
enum StockMovementType {
  // ── movements that change PHYSICAL stock ────────────────
  INWARD
  OUTWARD
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_IN
  TRANSFER_OUT

  // ── movements that change RESERVED stock ────────────────
  // Physical stock does not move: the boxes are still on the
  // shelf, they are just promised to somebody.
  RESERVATION
  RESERVATION_RELEASE

  // ── movements that change DAMAGED stock ─────────────────
  // Physical stock does not move either. A broken box is still
  // in the warehouse; it has stopped being sellable. Writing it
  // off is a separate ADJUSTMENT_DECREASE, which is a different
  // decision made by a different person.
  DAMAGE
  DAMAGE_RECOVERY

  // ── movements that change IN-TRANSIT stock ──────────────
  // Held against the DESTINATION warehouse while stock is on its
  // way. TRANSFER_LOSS writes off a quantity that was dispatched
  // but never arrives and is never going to -- posted only
  // through an explicit, reasoned resolution of a transfer
  // receipt, never automatically.
  TRANSFER_LOSS
  TRANSFER_LOSS_REVERSAL

  // NO "REVERSAL" MEMBER, DELIBERATELY.
  //
  // A reversal is the OPPOSITE movement, carrying
  // reversalOfEntryId. Recording it as its own type would throw
  // away the direction -- "REVERSAL" alone cannot say whether
  // stock went up or down -- and every balance calculation would
  // then need a special case to look up what it reversed. The
  // step-2 design already had this right.
}

/// WHY it moved. Separate from the type because "stock went out"
/// and "stock went out because it broke" answer different
/// questions, and a sales report that counts breakages as sales is
/// worse than no report.
enum StockMovementReason {
  OPENING_STOCK
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  SALES_DISPATCH
  SALES_RETURN
  SAMPLE_ISSUE
  DAMAGE
  /// A damaged box turned out to be fine, or was repaired.
  DAMAGE_RECOVERY
  STOCK_COUNT_CORRECTION
  WAREHOUSE_TRANSFER
  /// Stock promised to a confirmed order, or released again when
  /// the order is dispatched or cancelled.
  RESERVATION
  RESERVATION_RELEASE
  /// Dispatched on a transfer but never arrived, written off
  /// through an explicit, reasoned resolution -- never guessed or
  /// posted automatically.
  TRANSFER_LOSS
  OTHER
}

/// The kind of document a movement points back to. Stored beside a
/// referenceId so a movement can always be traced to what caused it.
enum StockReferenceType {
  PURCHASE_ORDER
  /// What a receipt's stock movements point at. Distinct from
  /// PURCHASE_ORDER on purpose: the order is the agreement, the
  /// note is the delivery, and only the second one moved stock.
  GOODS_RECEIPT_NOTE
  PURCHASE_RETURN
  /// What a dispatch's stock movements point at -- the delivery
  /// challan, not the sales order. The order is the agreement,
  /// the challan is what actually left the building.
  DELIVERY_CHALLAN
  SALES_RETURN
  SALES_ORDER
  STOCK_ADJUSTMENT
  WAREHOUSE_TRANSFER
  OPENING_BALANCE
  MANUAL
}

/// THE PURCHASE ORDER LIFECYCLE.
///
///     DRAFT ─▶ PENDING_APPROVAL ─▶ APPROVED ─┬─▶ PARTIALLY_RECEIVED ─▶ FULLY_RECEIVED
///       │             │                      │            │                   │
///       └─────────────┴──────────────────────┴▶ CANCELLED └───────────────────┴▶ CLOSED
///
/// CANCELLED is reachable only while NOTHING has been received: an
/// order goods have arrived against did happen, and pretending
/// otherwise would orphan the stock that came in on it. Such an
/// order is CLOSED instead, short of its full quantity, with a
/// reason recorded.
///
/// APPROVED was called ORDERED and FULLY_RECEIVED was called
/// RECEIVED, through step 5. They were renamed rather than
/// replaced -- a rename rewrites no rows and leaves no dead
/// members -- and there were no purchase orders in any database at
/// the time.
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  CLOSED
}

/// A goods receipt is DRAFT until it is posted. Posting is what
/// moves stock, and it is irreversible: the ledger entries it
/// wrote cannot be unwritten. A receipt entered by mistake is
/// corrected by a purchase return or an adjustment, not by
/// deleting the note.
enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// A supplier invoice is a CLAIM FOR PAYMENT. It is deliberately
/// not evidence that anything arrived: only a posted goods receipt
/// is that. An invoice can be recorded, matched against receipts,
/// disputed or cancelled, and none of it touches stock.
enum SupplierInvoiceStatus {
  RECEIVED
  MATCHED
  DISPUTED
  CANCELLED
}

/// HOW GST APPLIES TO ONE PURCHASE, decided when the order is
/// raised and then frozen on it.
///
/// For goods, the place of supply is where they are delivered, so
/// the comparison is the SUPPLIER's state against the RECEIVING
/// WAREHOUSE's state.
///
///   INTRA_STATE  same state      -> CGST + SGST, half each
///   INTER_STATE  different state -> IGST, the whole rate
///   UNREGISTERED supplier has no GSTIN -> no GST charged on the
///                document. Reverse charge, where it applies, is
///                an accounting matter and out of this phase.
///
/// There is deliberately no "assume intra-state" fallback. If the
/// two state codes cannot be established the order is refused,
/// because guessing produces a tax figure that is wrong in a way
/// nobody notices until an audit.
enum GstTreatment {
  INTRA_STATE
  INTER_STATE
  UNREGISTERED
}

/// THE SALES ORDER LIFECYCLE.
///
///     DRAFT -> PENDING_APPROVAL -> CONFIRMED -> PARTIALLY_RESERVED -> RESERVED
///       |              |               |                                 |
///       +--------------+---------------+-> CANCELLED                     v
///                                                              PARTIALLY_DISPATCHED
///                                                                         |
///                                                                         v
///                                                                FULLY_DISPATCHED
///                                                                         |
///                                                                         v
///                                                                      CLOSED
///
/// CANCELLED is reachable only while NOTHING has shipped: stock
/// that has actually left the building is a fact, and pretending
/// otherwise would orphan it. An order already dispatched in part
/// is CLOSED instead, short of its full quantity, with a reason.
///
/// Renamed from the step-2 names, which predate the separate
/// Quotation document this step adds: QUOTATION -> DRAFT,
/// DISPATCHED -> PARTIALLY_DISPATCHED, INVOICED ->
/// FULLY_DISPATCHED, DELIVERED -> CLOSED. A rename rewrites no
/// rows, and there were no sales orders in any database when this
/// ran.
enum SalesOrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  PARTIALLY_RESERVED
  RESERVED
  PARTIALLY_DISPATCHED
  FULLY_DISPATCHED
  CLOSED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

/// A sales invoice is DRAFT until posted; posting commits the
/// price and tax snapshot but -- unlike a goods receipt -- moves
/// NO stock. See the architecture note in SALES_MANAGEMENT.md
/// section 7 for why dispatch, not invoicing, is the chosen
/// inventory event.
enum SalesInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DeliveryChallanStatus {
  DRAFT
  DISPATCHED
  CANCELLED
}

enum SalesReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// What came back, and what it is worth doing with it.
/// Only ACCEPTED_GOOD may return to sellable stock.
enum ReturnDisposition {
  ACCEPTED_GOOD
  DAMAGED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
  OTHER
}

/// HOW GST APPLIES TO ONE SALE, decided when the order is raised
/// and then frozen on it. For goods the place of supply is where
/// they are delivered, so the comparison is the SELLING
/// WAREHOUSE's state against the CUSTOMER's shipping state --
/// the mirror image of the purchase side, which compares the
/// supplier against the receiving warehouse.
///
/// UNLIKE THE PURCHASE SIDE: a customer with no GSTIN is not
/// exempt. An unregistered buyer is an ordinary retail (B2C) sale
/// and still carries GST; only an explicitly exempt or export
/// sale would not, and neither is implemented in this phase.
enum SalesGstTreatment {
  INTRA_STATE
  INTER_STATE
}

/// A document's life. POSTED is the line past which a document may
/// no longer be edited, because stock has moved on the strength of
/// it: from there a correction is a new document, never an edit.
enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum CustomerType {
  RETAIL
  TRADE
  PROJECT
  INTERNAL
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  APPROVE
  RECEIVE
  RESERVE
  DISPATCH
  CLOSE
  CANCEL
  LOGIN
  EXPORT
  IMPORT
}

/// Where a product stands with the website. NOT a product status:
/// a product is perfectly valid without the website ever having
/// heard of it.
enum SyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED
  /// The website changed a field the ERP owns. That is a conflict
  /// for a person to resolve, not an update to accept.
  CONFLICT
}

/// An outbox row's life. The ERP writes the event in the SAME
/// transaction as the business change, so a change can never be
/// made without its notification, nor a notification sent for a
/// change that rolled back.
enum IntegrationEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ============================================================
// 1. PEOPLE AND ACCESS
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  /// Argon2id or bcrypt. Null for an invited account that has not
  /// set one yet. NEVER a plaintext or reversible value.
  passwordHash String?
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?

  /// If the studio later decides one person signs in once for both
  /// systems, this holds the website's user id. Nullable and
  /// unenforced today, because that decision is still open — see
  /// the open questions in ARCHITECTURE.md.
  websiteUserId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles UserRole[]

  // Everything this user is on the record for. All Restrict: an
  // account that posted a stock movement cannot be deleted, because
  // deleting it would orphan the entry that names who did it.
  // Disable the account instead; that is what UserStatus is for.
  createdProducts      Product[]            @relation("ProductCreatedBy")
  updatedProducts      Product[]            @relation("ProductUpdatedBy")
  archivedProducts     Product[]            @relation("ProductArchivedBy")
  createdProductLines  ProductLine[]        @relation("ProductLineCreatedBy")
  updatedProductLines  ProductLine[]        @relation("ProductLineUpdatedBy")
  uploadedImages       ProductImage[]
  stockEntries         StockLedgerEntry[]
  adjustments          StockAdjustment[]
  importBatches        ImportBatch[]
  purchaseOrders       PurchaseOrder[]
  transfers            WarehouseTransfer[]
  transfersDispatched  WarehouseTransfer[]  @relation("TransferDispatchedBy")
  transfersReceived    WarehouseTransfer[]  @relation("TransferReceivedBy")
  posApproved          PurchaseOrder[]      @relation("PoApprovedBy")
  posCancelled         PurchaseOrder[]      @relation("PoCancelledBy")
  posClosed            PurchaseOrder[]      @relation("PoClosedBy")
  grnsReceived         GoodsReceiptNote[]   @relation("GrnReceivedBy")
  grnsPosted           GoodsReceiptNote[]   @relation("GrnPostedBy")
  grnsCancelled        GoodsReceiptNote[]   @relation("GrnCancelledBy")
  returnsCreated       PurchaseReturn[]     @relation("ReturnCreatedBy")
  returnsPosted        PurchaseReturn[]     @relation("ReturnPostedBy")
  supplierInvoices     SupplierInvoice[]    @relation("InvoiceCreatedBy")
  quotesCreated        Quotation[]          @relation("QuoteCreatedBy")
  quotesConverted      Quotation[]          @relation("QuoteConvertedBy")
  salesOrdersCreated   SalesOrder[]         @relation("SoCreatedBy")
  salesOrdersApproved  SalesOrder[]         @relation("SoApprovedBy")
  salesOrdersCancelled SalesOrder[]         @relation("SoCancelledBy")
  salesOrdersClosed    SalesOrder[]         @relation("SoClosedBy")
  invoicesCreated      SalesInvoice[]       @relation("InvCreatedBy")
  invoicesPosted       SalesInvoice[]       @relation("InvPostedBy")
  invoicesCancelled    SalesInvoice[]       @relation("InvCancelledBy")
  challansCreated      DeliveryChallan[]    @relation("DcCreatedBy")
  challansDispatched   DeliveryChallan[]    @relation("DcDispatchedBy")
  challansCancelled    DeliveryChallan[]    @relation("DcCancelledBy")
  salesReturnsReceived SalesReturn[]        @relation("SrReceivedBy")
  salesReturnsPosted   SalesReturn[]        @relation("SrPostedBy")
  paymentsRecorded     CustomerPayment[]    @relation("PaymentRecordedBy")
  auditLogs            AuditLog[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// A built-in role the application depends on. Guards against
  /// somebody deleting "Administrator" and locking everyone out.
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId String @db.Uuid
  /// "resource:action", e.g. "product:update", "stock:post".
  /// The same convention the Casa De Aurum backend already uses,
  /// so one mental model covers both systems.
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

// ============================================================
// 2. CATALOGUE MASTER DATA
// ============================================================

model Brand {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String  @unique
  isActive Boolean @default(true)

  /// Additive, step "product hierarchy": the brief's Company fields
  /// beyond name/code/status. Nullable because every brand created
  /// before this step has neither.
  logoUrl     String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  collections  Collection[]
  productLines ProductLine[]

  @@index([isActive])
  @@map("brands")
}

/// THE PRODUCT HEAD — ALSO CALLED THE SERIES.
///
/// "Kajaria Neo Sapien". One head, many variants: Grey, Brown and
/// Blue are three Products under this one row, and changing a
/// colour never creates a second head.
///
/// NAMING. The table is `collections` because it was created in
/// step 2, before the term "Product Head" was settled on. The two
/// are the same thing and the API calls it productHead throughout.
/// It was not renamed because renaming a table that already holds
/// data and foreign keys buys nothing the comment does not; say the
/// word and it is one non-destructive ALTER TABLE.
///
/// Scoped to a brand, because that is what a series is in this
/// trade: two brands may both sell something called Verona and they
/// are not the same range.
model Collection {
  id       String  @id @default(uuid()) @db.Uuid
  brandId  String  @db.Uuid
  code     String
  name     String
  /// THE HEAD'S OWN CATEGORY. Added in step 3: a head belongs to a
  /// category, and its variants inherit that unless one genuinely
  /// differs. Nullable because the heads created in step 2 predate
  /// the column, and backfilling a guess would be worse than
  /// leaving the truth — that nobody has said yet.
  categoryId String? @db.Uuid
  description String?
  isActive Boolean @default(true)

  /// Additive, step "product hierarchy": the brief's Collection
  /// fields beyond name/code/description/status. Nullable because
  /// every collection created before this step has neither.
  coverImageUrl        String?
  catalogueDocumentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand        Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products     Product[]
  productLines ProductLine[]

  @@unique([brandId, code])
  @@index([brandId])
  @@index([categoryId])
  @@map("collections")
}

/// THE PRODUCT, AS ITS OWN ROW — ADDED BY THE "PRODUCT HIERARCHY"
/// STEP. Before this, "Onery Elite Decore" existed only as a name
/// string repeated across three sibling `Product` rows (Matte
/// 600x1200, Glossy 600x1200, Matte 800x1600) -- nothing had an id
/// of its own to hold a shared description, specification sheet or
/// cover image, and nothing stopped three unrelated rows that
/// happen to share a name from being mistaken for one product.
///
/// NAMING. This table is `product_lines` precisely so it does NOT
/// collide with the existing `Product` model/table, which keeps
/// meaning exactly what it has always meant since step 3: one
/// sellable SKU, with its own finish, size and colour. The brief's
/// own vocabulary calls both of these "Product" (the line AND the
/// variant) -- the API and the Product Master screen expose this
/// one as "Product" and the existing one as the SKU/variant it sits
/// above, the same display-name-vs-table-name split `collections`
/// already uses for "Product Head".
///
/// A ProductLine is OPTIONAL on Product (`productLineId` is
/// nullable): every product created before this step, and any
/// product a person chooses not to group, keeps working exactly as
/// before. Nothing here is required.
model ProductLine {
  id           String  @id @default(uuid()) @db.Uuid
  brandId      String  @db.Uuid
  collectionId String? @db.Uuid
  /// Inherited by its variants unless one genuinely differs --
  /// the same rule `Collection.categoryId` already states.
  categoryId   String? @db.Uuid

  code        String
  name        String
  description String?
  /// Category-specific facts that do not vary by finish or size --
  /// a GRC panel's projection, say. Deliberately a sibling of
  /// `Product.attributes`, not a replacement for it: an attribute
  /// that DOES vary by variant (a tile's own colour reading) still
  /// lives on the variant.
  specifications Json?
  /// The catalogue-card picture, shown before a finish is chosen.
  /// Not a replacement for ProductImage, which stays scoped to the
  /// variant that was actually photographed.
  imageUrl String?

  isActive Boolean @default(true)

  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand      Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  collection Collection?      @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy  User?            @relation("ProductLineCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User?            @relation("ProductLineUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  /// The finish/size variants under this product. A variant without
  /// a ProductLine (productLineId null) is not an error -- it is a
  /// product nobody has grouped yet.
  variants Product[]

  @@unique([brandId, collectionId, code])
  @@index([brandId])
  @@index([collectionId])
  @@index([categoryId])
  @@map("product_lines")
}

/// Commercial grouping, for buying, reporting and tax. Not the
/// website's idea of a tile's type or best room, which are design
/// facts; this is the ERP's own structure.
model ProductCategory {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  /// Self-reference, so Floor Tiles can hold Large Format Slabs.
  /// Restrict, so a parent with children cannot be deleted out
  /// from under them.
  parentId String? @db.Uuid
  hsnCode  String?
  sortOrder Int    @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  productHeads Collection[]
  productLines ProductLine[]

  @@index([parentId])
  @@map("product_categories")
}

// ============================================================
// 3. PRODUCT MASTER
// ============================================================

model Product {
  /// THE PERMANENT PRODUCT ID. Generated once, never reused, never
  /// changed — not even if the SKU is corrected or the product is
  /// retired. Every historical movement, order line and website
  /// mapping points here, so this id outliving every other fact
  /// about the product is the point of it.
  id String @id @default(uuid()) @db.Uuid

  /// The studio's own code. Unique, and the one humans quote.
  /// Separate from `id` because a SKU is a business decision and
  /// business decisions get corrected; an identity must not.
  sku String @unique

  name String

  brandId      String  @db.Uuid
  categoryId   String  @db.Uuid
  collectionId String? @db.Uuid
  /// The product this variant belongs to, e.g. "Onery Elite Decore"
  /// for a Matte-600x1200 and a Glossy-600x1200 row alike. Nullable:
  /// a variant with no ProductLine is not an error, only ungrouped.
  productLineId String? @db.Uuid

  // ── physical description ──────────────────────────────────
  /// As printed on the box, e.g. "600x1200mm".
  size        String
  /// The same size as numbers, so a report can sort and filter by
  /// it. Nullable because an odd-shaped product may not have one.
  lengthMm    Int?
  widthMm     Int?
  thicknessMm Decimal? @db.Decimal(6, 2)
  finish      String?
  colour      String?

  // ── how it is counted ─────────────────────────────────────
  uom            UnitOfMeasure @default(BOX)
  /// What one unit contains. Needed to turn a price per sqft into
  /// the value of a box, which is most of the arithmetic in here.
  piecesPerUnit  Int?
  areaSqftPerUnit Decimal? @db.Decimal(10, 3)

  // ── money ─────────────────────────────────────────────────
  /// Both prices are expressed in `priceBasis`, stated rather than
  /// assumed. Decimal, never Float.
  purchasePrice Decimal    @db.Decimal(14, 2)
  sellingPrice  Decimal    @db.Decimal(14, 2)
  mrp           Decimal?   @db.Decimal(14, 2)
  priceBasis    PriceBasis @default(PER_SQFT)
  /// Overrides the category's code where a product differs.
  hsnCode       String?

  /// Default reorder level. A per-warehouse override lives on
  /// InventoryBalance, for when the studio holds stock in more
  /// than one place.
  reorderLevel Decimal @default(0) @db.Decimal(14, 3)

  /// The MAIN image. Kept in step with the ProductImage row whose
  /// role is MAIN, written in the same transaction — the same
  /// projection pattern as InventoryBalance, and checked the same
  /// way. ProductImage is the source; this is the convenience
  /// pointer the list screens read without a join.
  imageUrl String?

  /// WHAT THIS CATEGORY NEEDS THAT TILES DO NOT.
  ///
  /// A GRC panel has a projection and a material; a tile has a
  /// surface type. Neither belongs as a column on every product in
  /// the catalogue, and adding one per category would mean a
  /// migration every time the studio starts selling something new.
  ///
  /// The keys are not free-form: productRules.mjs declares what
  /// each category requires and permits, and validation rejects a
  /// key no rule allows. A JSON column with no rules behind it is
  /// just a place for typos to accumulate.
  attributes Json?

  status ProductStatus @default(ACTIVE)

  /// ARCHIVED IS NOT A STATUS, AND THAT IS DELIBERATE.
  ///
  /// The three statuses say what the studio has decided
  /// COMMERCIALLY: on sale, withdrawn, retired. Archiving says
  /// something different — "keep this out of my way" — and the two
  /// are independent: a discontinued product may or may not be
  /// archived, and both facts matter.
  ///
  /// It is also why archiving is the answer to "delete this
  /// product". A product with stock history cannot be deleted
  /// without orphaning the movements that explain where the stock
  /// went, and the database refuses. Archiving hides it and keeps
  /// the history.
  archivedAt   DateTime?
  archivedById String?   @db.Uuid

  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category    ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collection  Collection?      @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  productLine ProductLine?     @relation(fields: [productLineId], references: [id], onDelete: Restrict)
  createdBy  User?            @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User?            @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy User?            @relation("ProductArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  inventory           InventoryBalance[]
  stockEntries        StockLedgerEntry[]
  adjustmentLines     StockAdjustmentLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines   GoodsReceiptNoteLine[]
  purchaseReturnLines PurchaseReturnLine[]
  quotationLines      QuotationLine[]
  salesInvoiceLines   SalesInvoiceLine[]
  deliveryChallanLines DeliveryChallanLine[]
  salesReturnLines    SalesReturnLine[]
  salesOrderLines     SalesOrderLine[]
  transferLines       WarehouseTransferLine[]
  websiteMapping      WebsiteProductMapping?
  images              ProductImage[]
  importRowsMatched   ImportRow[]            @relation("ImportRowMatched")
  importRowsCreated   ImportRow[]            @relation("ImportRowCreated")

  @@index([brandId])
  @@index([categoryId])
  @@index([collectionId])
  @@index([productLineId])
  @@index([status])
  @@index([name])
  /// The list screen's default view: everything not archived.
  @@index([archivedAt])
  /// Filtering by the variant attributes, which the Product Master
  /// screen offers as four separate filters.
  @@index([colour])
  @@index([finish])
  @@index([size])
  @@map("products")
}

// ============================================================
// 4. WAREHOUSES AND INVENTORY
// ============================================================

model Warehouse {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  addressLine String?
  city        String?
  state       String?
  postalCode  String?

  /// The GST state code of the place goods are delivered to. For
  /// goods, the place of supply IS the delivery address, so this is
  /// one half of every purchase's GST treatment; the supplier's
  /// state code is the other. Without it an order cannot be taxed,
  /// and the service says so rather than assuming.
  stateCode String?
  /// The studio's own registration at this location, where it has
  /// one. Printed on purchase paperwork.
  gstin String?
  /// Exactly one warehouse carries this. The ERP holds stock in one
  /// place today; the schema is already multi-warehouse so that
  /// adding a second is data entry rather than a migration of every
  /// stock figure in the system.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory       InventoryBalance[]
  stockEntries    StockLedgerEntry[]
  adjustments     StockAdjustment[]
  purchaseOrders  PurchaseOrder[]
  salesOrders     SalesOrder[]
  transfersOut    WarehouseTransfer[] @relation("TransferFrom")
  transfersIn     WarehouseTransfer[] @relation("TransferTo")
  goodsReceipts   GoodsReceiptNote[]
  purchaseReturns PurchaseReturn[]
  quotations      Quotation[]
  salesInvoices   SalesInvoice[]
  deliveryChallans DeliveryChallan[]
  salesReturns    SalesReturn[]

  @@index([isActive])
  @@map("warehouses")
}

/// WHAT IS ON THE SHELF, PER PRODUCT PER WAREHOUSE.
///
/// This table is a PROJECTION of the stock ledger, not a second
/// source of truth. It exists because summing a product's whole
/// movement history on every page load stops being viable at a few
/// hundred thousand rows — and for nothing else.
///
/// Three things keep it honest:
///
///   1. It is only ever written in the SAME transaction as the
///      ledger entry that caused it. There is no path that moves
///      stock without writing both, and none that writes this
///      without a ledger entry.
///   2. The row is locked (SELECT ... FOR UPDATE) before it is
///      read-modified-written, so two dispatches of the same
///      product at the same instant queue instead of racing. Last
///      writer wins is not an acceptable answer for a stock figure.
///   3. The view v_inventory_reconciliation recomputes every
///      balance from the ledger and reports any row where the two
///      disagree. If this table were ever wrong, that view says so.
///
/// `version` is for optimistic checks in application code on top of
/// the row lock; it also makes a lost update visible after the fact.
model InventoryBalance {
  id          String @id @default(uuid()) @db.Uuid
  productId   String @db.Uuid
  warehouseId String @db.Uuid

  /// Physically present. Never negative — a database CHECK enforces
  /// it, because "we dispatched more than we had" is a data error,
  /// not a number.
  quantityOnHand Decimal @default(0) @db.Decimal(14, 3)
  /// Committed to a confirmed order but not yet dispatched. Part
  /// of quantityOnHand, not additional to it: the boxes are on the
  /// shelf and somebody else's.
  quantityReserved Decimal @default(0) @db.Decimal(14, 3)

  /// Physically present and not sellable. ALSO part of
  /// quantityOnHand: a broken box is still a box in the warehouse,
  /// and pretending otherwise makes the stock-take disagree with
  /// the system. Writing it off is an ADJUSTMENT_DECREASE, which
  /// is a separate decision.
  quantityDamaged Decimal @default(0) @db.Decimal(14, 3)

  /// ON ITS WAY HERE, AND COUNTED NOWHERE ELSE.
  ///
  /// Stock that has left another warehouse on a transfer and has
  /// not yet been received. It is held against the DESTINATION,
  /// because that is where it is going and where somebody will
  /// eventually count it.
  ///
  /// It is deliberately NOT part of quantityOnHand: a lorry is not
  /// a shelf, and nobody can pick from it. Company-wide physical
  /// stock is therefore
  ///
  ///     SUM(quantityOnHand) + SUM(quantityInTransit)
  ///
  /// which stays constant across a transfer -- the source's
  /// on-hand falls and this rises by the same amount, then the
  /// reverse on receipt. Nothing is counted twice at any point.
  quantityInTransit Decimal @default(0) @db.Decimal(14, 3)

  /// Per-warehouse override of Product.reorderLevel.
  reorderLevel Decimal? @db.Decimal(14, 3)

  lastMovementAt DateTime?
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  /// One balance per product per warehouse. This is what makes the
  /// lock-and-update pattern above safe: there is exactly one row
  /// to lock.
  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

/// THE STOCK LEDGER. APPEND-ONLY.
///
/// Every box that has ever entered or left, and why. This is the
/// source of truth for stock; InventoryBalance above is only a
/// running total of it.
///
/// APPEND-ONLY IS ENFORCED BY THE DATABASE, not by convention.
/// A trigger (see migration 20261120_append_only_guards) raises an
/// exception on any UPDATE or DELETE of this table. It is not a
/// matter of the application being careful: an ORM bug, a console
/// session or a future developer in a hurry all hit the same wall.
///
/// A mistake is corrected by POSTING THE OPPOSITE ENTRY, linked
/// back through `reversalOfEntryId`. The wrong entry stays visible
/// for ever, which is the entire point: a stock history you can
/// quietly edit is a stock history nobody can rely on in a dispute.
model StockLedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  /// A gap-free, monotonically increasing number. Gives the ledger
  /// a total order independent of clocks, so two entries recorded
  /// in the same millisecond still have an unambiguous sequence.
  entryNo BigInt @unique @default(autoincrement())

  productId   String @db.Uuid
  warehouseId String @db.Uuid

  movementType StockMovementType
  reason       StockMovementReason

  /// ALWAYS POSITIVE. The direction lives in movementType, so a
  /// quantity can never be accidentally negated into the wrong
  /// direction. A CHECK constraint enforces the sign.
  quantity Decimal       @db.Decimal(14, 3)
  uom      UnitOfMeasure

  /// Value per unit at the moment it moved, and the line value.
  /// Captured now, whatever valuation method is chosen later:
  /// without a per-movement cost, neither FIFO nor a weighted
  /// average can be computed retrospectively.
  unitCost    Decimal? @db.Decimal(14, 2)
  valueAmount Decimal? @db.Decimal(14, 2)

  /// WHAT THE BALANCE WAS BEFORE, AND WHAT IT BECAME.
  ///
  /// Both written inside the same locked transaction, so a stock
  /// card reads as a statement does -- opening, movement, closing
  /// -- and a reader can check each line without re-summing the
  /// history above it. The pair also makes a gap obvious: if one
  /// row's balanceAfter is not the next row's balanceBefore,
  /// something wrote stock outside the ledger.
  ///
  /// These are always PHYSICAL on-hand. A reservation or a damage
  /// entry leaves them unchanged -- the boxes have not moved --
  /// and records its own effect in the two columns below.
  balanceBefore Decimal @default(0) @db.Decimal(14, 3)
  balanceAfter  Decimal @db.Decimal(14, 3)

  /// The other two dimensions as they stood after this entry, so
  /// one row answers "what was on the shelf, what was promised,
  /// and what was broken" without joining to anything.
  reservedAfter Decimal @default(0) @db.Decimal(14, 3)
  damagedAfter  Decimal @default(0) @db.Decimal(14, 3)

  /// In-transit at this product+warehouse after this entry.
  /// NULL on every entry written before this column existed --
  /// those rows never recorded what in-transit was at the time,
  /// and backfilling them to 0 would claim a figure nobody
  /// measured. Every entry from here on always carries a real
  /// value, whether or not this entry's own movement touched the
  /// in-transit dimension, for the same reason reservedAfter and
  /// damagedAfter always do.
  inTransitAfter Decimal? @db.Decimal(14, 3)

  referenceType StockReferenceType
  /// The id of the document that caused this. Not a foreign key:
  /// it points at several different tables by referenceType, and
  /// the whole point of the ledger is that it survives whatever
  /// happens to them.
  referenceId   String? @db.Uuid
  /// The document's human number, copied in as text. Survives even
  /// if the document is later renumbered or removed: a ledger entry
  /// must still be explicable in ten years.
  referenceNo   String?

  /// The business date, which is not always the moment of entry —
  /// a receipt entered on Monday may belong to Saturday.
  transactionDate DateTime
  remarks         String?

  /// PREVENTS ACCIDENTAL DUPLICATES. A caller builds this from what
  /// the movement IS (document, line, action), so a retried API
  /// call, a double-clicked button or a replayed queue message
  /// lands on a unique-constraint violation instead of moving the
  /// stock twice.
  idempotencyKey String @unique

  /// Set on a correcting entry, pointing at the entry it reverses.
  /// The original is never touched.
  reversalOfEntryId String? @db.Uuid

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse  Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy  User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf StockLedgerEntry? @relation("LedgerReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversals  StockLedgerEntry[] @relation("LedgerReversal")

  /// The index a stock card is read by.
  @@index([productId, warehouseId, transactionDate, entryNo])
  /// The index "what did this document move?" is answered by.
  @@index([referenceType, referenceId])
  @@index([warehouseId, transactionDate])
  @@index([reason])
  @@map("stock_ledger_entries")
}

// ============================================================
// 5. STOCK ADJUSTMENTS
// ============================================================

/// A stock count or a written-off breakage, as a document. The
/// adjustment is what a person approves; the ledger entries are
/// what it produces when posted.
model StockAdjustment {
  id            String         @id @default(uuid()) @db.Uuid
  adjustmentNo  String         @unique
  warehouseId   String         @db.Uuid
  reason        StockMovementReason @default(STOCK_COUNT_CORRECTION)
  status        DocumentStatus @default(DRAFT)
  notes         String?

  /// Once posted, stock has moved on the strength of this document
  /// and it becomes read-only. A correction is a new adjustment.
  postedAt    DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines     StockAdjustmentLine[]

  @@index([warehouseId, status])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           String @id @default(uuid()) @db.Uuid
  adjustmentId String @db.Uuid
  lineNo       Int
  productId    String @db.Uuid

  /// What the count found, and what the system thought it held at
  /// the moment of counting. Both are kept: the difference is the
  /// movement, and the two originals are the evidence for it.
  countedQuantity  Decimal @db.Decimal(14, 3)
  expectedQuantity Decimal @db.Decimal(14, 3)
  uom              UnitOfMeasure
  remarks          String?

  /// Cascade is correct here and only here: a line has no meaning
  /// without its document, and a posted document cannot be deleted
  /// at all.
  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, lineNo])
  @@index([productId])
  @@map("stock_adjustment_lines")
}

// ============================================================
// 6. THE PEOPLE ON THE OTHER SIDE
// ============================================================

model Supplier {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique
  name  String
  gstin String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?

  /// THE GST STATE CODE: the two digits that decide whether a
  /// purchase attracts CGST+SGST or IGST. It is also the first two
  /// characters of the GSTIN, so where a GSTIN is recorded this is
  /// derived from it and the two are checked against each other --
  /// a supplier whose GSTIN says 24 and whose state code says 27
  /// is a data-entry error worth catching at the form.
  stateCode String?

  /// Where goods are collected from, when that is not the billing
  /// address. Kept separate because a supplier's registered office
  /// and its despatch warehouse are routinely in different places.
  shippingAddressLine String?
  shippingCity        String?
  shippingState       String?
  shippingStateCode   String?
  shippingPostalCode  String?

  /// Free text: "30 days", "Advance". Deliberately not an enum —
  /// supplier terms are whatever was negotiated.
  paymentTerms String?
  /// The same terms as a number, where they reduce to one. Used to
  /// work out when an invoice falls due; null where the terms do
  /// not reduce to a count of days ("Advance").
  creditPeriodDays Int?

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceiptNote[]
  purchaseReturns PurchaseReturn[]
  invoices        SupplierInvoice[]

  @@index([isActive])
  @@index([stateCode])
  @@map("suppliers")
}

model Customer {
  id    String       @id @default(uuid()) @db.Uuid
  code  String       @unique
  name  String
  type  CustomerType @default(RETAIL)
  gstin String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?

  /// THE GST STATE CODE: the two digits that decide whether a sale
  /// attracts CGST+SGST or IGST, compared against the selling
  /// warehouse's own state code. Derived from the GSTIN where one
  /// is recorded, the same way a supplier's is on the purchase
  /// side.
  stateCode String?

  /// Where goods are delivered, when that differs from the billing
  /// address -- a site address for a project customer, most
  /// commonly. For GOODS the place of supply is the SHIPPING
  /// state, so this is the side of the GST decision that actually
  /// matters; billing address and state are what appears on the
  /// invoice.
  shippingAddressLine String?
  shippingCity        String?
  shippingState       String?
  shippingStateCode   String?
  shippingPostalCode  String?

  /// Free text, as on the supplier side: whatever was agreed.
  paymentTerms String?
  /// Reduces to a day count where the terms do; null where they do
  /// not ("Advance"). Used to work out an invoice's due date.
  creditPeriodDays Int?

  notes    String?
  isActive Boolean @default(true)

  /// Where this customer came from, if they were created by the
  /// website rather than at the counter. A loose reference, not a
  /// foreign key: the ERP must work with the website switched off.
  websiteCustomerRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations      Quotation[]
  salesOrders     SalesOrder[]
  invoices        SalesInvoice[]
  deliveryChallans DeliveryChallan[]
  salesReturns    SalesReturn[]
  payments        CustomerPayment[]

  @@index([isActive])
  @@index([type])
  @@index([stateCode])
  @@map("customers")
}

// ============================================================
// 7. PURCHASE
// ============================================================

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  orderNo     String              @unique
  supplierId  String              @db.Uuid
  /// Where the goods are expected to land.
  warehouseId String              @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)

  orderDate    DateTime
  expectedDate DateTime?

  /// WHERE THE PAPERWORK GOES AND WHERE THE GOODS GO. Snapshots,
  /// written when the order is raised. The supplier may move
  /// afterwards; what was agreed must still read the way it read on
  /// the day, and a reprint of last year's order must not quietly
  /// show this year's address.
  billingAddress  String?
  shippingAddress String?
  paymentTerms    String?

  /// HOW GST APPLIES, decided once from the supplier's state and
  /// the receiving warehouse's state, then frozen here. Recomputing
  /// it on read would change an old order's tax the day a supplier
  /// updates its address.
  gstTreatment       GstTreatment
  supplierStateCode  String?
  placeOfSupplyCode  String?

  /// Totals are STORED, not computed on read. A supplier's invoice
  /// is a historical fact; recomputing it from today's prices would
  /// quietly rewrite what was agreed.
  subTotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableTotal  Decimal @default(0) @db.Decimal(14, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  igstTotal     Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  otherCharges  Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("INR")

  notes String?

  /// WHO APPROVED IT, AND WHEN. An order that reached a supplier
  /// without a name against it is not a control. A CHECK enforces
  /// that the pair is all-or-nothing.
  submittedAt  DateTime?
  approvedById String?   @db.Uuid
  approvedAt   DateTime?

  cancelledById String?   @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?

  /// Short closure: the order is finished with, although less than
  /// the full quantity arrived. The reason is required, because
  /// "we stopped waiting" and "the supplier cannot supply" are
  /// different facts about the same number.
  closedById  String?   @db.Uuid
  closedAt    DateTime?
  closeReason String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?               @relation("PoApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledBy User?               @relation("PoCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  closedBy    User?               @relation("PoClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  lines       PurchaseOrderLine[]
  receipts    GoodsReceiptNote[]
  returns     PurchaseReturn[]
  invoices    SupplierInvoice[]

  @@index([supplierId])
  @@index([status, orderDate])
  @@index([warehouseId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  lineNo          Int
  productId       String @db.Uuid

  /// SNAPSHOTS, taken when the line was written. The product may
  /// later be renamed or re-coded; what was ordered must still read
  /// the way it read on the day. The productId still points at the
  /// live row for anyone who wants today's version.
  skuAtOrder  String
  nameAtOrder String

  /// The HSN code as it stood when the line was written, for the
  /// same reason as the SKU and the name.
  hsnAtOrder String?

  quantity  Decimal       @db.Decimal(14, 3)
  uom       UnitOfMeasure
  unitPrice Decimal       @db.Decimal(14, 2)

  /// THE LINE, STEP BY STEP, each step stored rather than derived:
  ///
  ///   grossAmount   = quantity x unitPrice
  ///   discountAmount
  ///   taxableValue  = grossAmount - discountAmount
  ///   taxAmount     = taxableValue x taxRate / 100
  ///   lineTotal     = taxableValue + taxAmount
  ///
  /// Storing each step is what lets somebody check the arithmetic
  /// of a two-year-old order without knowing which rate applied
  /// then, and what stops a rate change rewriting history.
  discountPercent Decimal @default(0) @db.Decimal(6, 3)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  grossAmount     Decimal @default(0) @db.Decimal(14, 2)
  taxableValue    Decimal @default(0) @db.Decimal(14, 2)

  /// The GST rate that applied to THIS line on THIS order. Taken
  /// from the product's category when the line is written and then
  /// frozen: the Product Master's HSN or rate may change, and an
  /// order already placed must not change with it.
  taxRate    Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount Decimal @default(0) @db.Decimal(14, 2)
  igstAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount  Decimal @default(0) @db.Decimal(14, 2)
  lineTotal  Decimal @db.Decimal(14, 2)

  /// When this particular line is due, where it differs from the
  /// order's own date.
  expectedDate DateTime?
  description  String?

  /// Running totals of what has actually arrived against this line.
  /// Maintained alongside the receipt's ledger entries, which stay
  /// the authority: these are a convenience for the screen, and the
  /// reconciliation check re-derives them from the receipts.
  ///
  /// receivedQuantity counts everything that ENTERED THE BUILDING,
  /// sound or broken, because both are things the supplier has
  /// delivered against the order. rejectedQuantity counts what was
  /// turned away at the gate and never entered stock at all, so the
  /// supplier still owes it.
  receivedQuantity Decimal @default(0) @db.Decimal(14, 3)
  rejectedQuantity Decimal @default(0) @db.Decimal(14, 3)

  purchaseOrder PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines  GoodsReceiptNoteLine[]

  @@unique([purchaseOrderId, lineNo])
  @@index([productId])
  @@map("purchase_order_lines")
}


/* ============================================================
   GOODS RECEIPT — WHERE PURCHASING MEETS INVENTORY
   ============================================================

   A PURCHASE ORDER DOES NOT CHANGE STOCK. Neither does approving
   one, and neither does a supplier's invoice. Stock changes when
   goods physically arrive and somebody posts a receipt for them.
   That is the whole reason this table exists rather than a
   "received" flag on the order.

   Posting a receipt writes its stock movements through
   postStockMovement(), in the same transaction, and nowhere else.
   Each line's movements carry a stable idempotency key derived
   from the line's own id, so a resubmitted form or a retried
   request posts the stock exactly once.
   ============================================================ */

model GoodsReceiptNote {
  id       String             @id @default(uuid()) @db.Uuid
  grnNo    String             @unique
  status   GoodsReceiptStatus @default(DRAFT)

  purchaseOrderId String @db.Uuid
  supplierId      String @db.Uuid
  /// Where the goods actually landed. Defaults to the order's
  /// warehouse but may differ: a lorry that was redirected is a
  /// fact about the delivery, not about the order.
  warehouseId     String @db.Uuid

  receiptDate DateTime
  /// The supplier's own despatch paperwork, for matching.
  supplierDocNo   String?
  supplierDocDate DateTime?
  /// A reference to wherever the signed delivery note is filed.
  /// Deliberately a string: the ERP stores no files in this phase.
  documentRef String?
  remarks     String?

  receivedById String    @db.Uuid
  postedById   String?   @db.Uuid
  postedAt     DateTime?

  cancelledById String?   @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy    User                   @relation("GrnReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  postedBy      User?                  @relation("GrnPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy   User?                  @relation("GrnCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines         GoodsReceiptNoteLine[]
  invoices      SupplierInvoice[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status, receiptDate])
  @@map("goods_receipt_notes")
}

model GoodsReceiptNoteLine {
  id                  String @id @default(uuid()) @db.Uuid
  goodsReceiptNoteId  String @db.Uuid
  lineNo              Int
  purchaseOrderLineId String @db.Uuid
  productId           String @db.Uuid

  skuAtReceipt  String
  nameAtReceipt String

  /// WHAT WAS ORDERED AND WHAT HAD ALREADY COME, as they stood when
  /// this note was written. Snapshots, so the note reads correctly
  /// later even though the order's running totals have moved on.
  orderedQuantity          Decimal @db.Decimal(14, 3)
  previouslyReceivedQuantity Decimal @default(0) @db.Decimal(14, 3)

  /// THE THREE DISPOSITIONS OF A DELIVERY, and they are not the
  /// same thing:
  ///
  ///   accepted  sound, into stock, sellable
  ///   damaged   into stock because it IS in the building, but
  ///             marked damaged so it is not sellable. A broken box
  ///             a stock-take would find has to be on the system,
  ///             or the count disagrees with the shelf.
  ///   rejected  turned away at the gate. Never entered stock at
  ///             all, so no movement is posted and the supplier
  ///             still owes the quantity.
  ///
  /// receivedQuantity = accepted + damaged: what came through the
  /// door. Rejected is excluded on purpose.
  acceptedQuantity Decimal @db.Decimal(14, 3)
  damagedQuantity  Decimal @default(0) @db.Decimal(14, 3)
  rejectedQuantity Decimal @default(0) @db.Decimal(14, 3)
  receivedQuantity Decimal @db.Decimal(14, 3)

  uom UnitOfMeasure
  /// The cost this stock came in at, copied from the order line and
  /// written onto the stock movement. Whatever valuation method is
  /// chosen later needs it, and it cannot be reconstructed.
  unitCost Decimal? @db.Decimal(14, 2)

  rejectionReason String?
  remarks         String?

  goodsReceiptNote  GoodsReceiptNote  @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptNoteId, lineNo])
  @@index([purchaseOrderLineId])
  @@index([productId])
  @@map("goods_receipt_note_lines")
}


/* ============================================================
   PURCHASE RETURN — STOCK GOING BACK TO THE SUPPLIER
   ============================================================
   Reduces stock through postStockMovement() like everything else.
   It does NOT edit the receipt that brought the stock in: that
   entry stays on the ledger, and the return sits beside it, which
   is how a stock card shows what actually happened.
   ============================================================ */

model PurchaseReturn {
  id       String               @id @default(uuid()) @db.Uuid
  returnNo String               @unique
  status   PurchaseReturnStatus @default(DRAFT)

  supplierId      String  @db.Uuid
  warehouseId     String  @db.Uuid
  purchaseOrderId String? @db.Uuid

  returnDate DateTime
  /// Why the goods went back. Required by the service: a return
  /// with no reason is a number somebody changed.
  reason     String
  remarks    String?
  documentRef String?

  createdById String    @db.Uuid
  postedById  String?   @db.Uuid
  postedAt    DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier      Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy      User?                @relation("ReturnPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines         PurchaseReturnLine[]

  @@index([supplierId])
  @@index([status, returnDate])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id               String @id @default(uuid()) @db.Uuid
  purchaseReturnId String @db.Uuid
  lineNo           Int
  productId        String @db.Uuid

  skuAtReturn  String
  nameAtReturn String

  quantity Decimal       @db.Decimal(14, 3)
  uom      UnitOfMeasure
  unitCost Decimal?      @db.Decimal(14, 2)
  /// Whether the boxes going back are sound stock or stock already
  /// marked damaged. The two come out of different dimensions of
  /// the balance, so the service has to be told which.
  fromDamaged Boolean @default(false)
  remarks     String?

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseReturnId, lineNo])
  @@index([productId])
  @@map("purchase_return_lines")
}


/* ============================================================
   SUPPLIER INVOICE — A CLAIM FOR PAYMENT, NOT A DELIVERY
   ============================================================
   Recording one changes NO stock. The three documents are
   deliberately separate rows in three separate tables:

     purchase order   what we agreed to buy
     goods receipt    what actually arrived   <- the only one that
                                                 moves stock
     supplier invoice what we are being asked to pay for

   They routinely disagree, and an ERP that conflates any two of
   them cannot show you how.
   ============================================================ */

model SupplierInvoice {
  id         String                @id @default(uuid()) @db.Uuid
  supplierId String                @db.Uuid
  status     SupplierInvoiceStatus @default(RECEIVED)

  /// The SUPPLIER's number, not ours. Unique per supplier: the same
  /// invoice number from two different suppliers is ordinary, the
  /// same one twice from one supplier is a double entry.
  invoiceNo   String
  invoiceDate DateTime
  dueDate     DateTime?

  purchaseOrderId    String? @db.Uuid
  goodsReceiptNoteId String? @db.Uuid

  taxableAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal @default(0) @db.Decimal(14, 2)
  invoiceAmount Decimal @db.Decimal(14, 2)
  currency      String  @default("INR")

  documentRef String?
  notes       String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  goodsReceiptNote GoodsReceiptNote? @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: Restrict)
  createdBy        User              @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// One invoice number per supplier. The database enforces it, so
  /// a double entry is refused even if two clerks save at once.
  @@unique([supplierId, invoiceNo])
  @@index([status, invoiceDate])
  @@map("supplier_invoices")
}


// ============================================================
// 8. SALES
// ============================================================

model SalesOrder {
  id          String           @id @default(uuid()) @db.Uuid
  orderNo     String           @unique
  customerId  String           @db.Uuid
  /// Which warehouse fulfils it. Single-warehouse fulfilment for
  /// now; splitting an order across locations is one of the open
  /// decisions.
  warehouseId String           @db.Uuid
  status      SalesOrderStatus @default(DRAFT)

  /// Where this order came from, when it was raised directly out
  /// of an accepted quotation. Optional: an order may be written
  /// from scratch with no quotation behind it.
  quotationId String? @db.Uuid

  orderDate           DateTime
  /// SUPERSEDED by expectedDispatchDate below. The step-2 column
  /// was ambiguous between an expected date and an actual one;
  /// kept, not dropped, and always null (zero rows existed
  /// before step 7).
  legacyDispatchDate   DateTime?
  /// WHEN DISPATCH IS PLANNED FOR. The ACTUAL dispatch date is a
  /// fact about a delivery challan, not about the order, and
  /// lives there instead -- an order can have several partial
  /// dispatches on different real dates.
  expectedDispatchDate DateTime?

  /// WHERE THE PAPERWORK GOES AND WHERE THE GOODS GO. Snapshots,
  /// written when the order is confirmed, for the same reason as
  /// on the purchase side: the customer's address may change
  /// afterwards and a reprint of an old order must not quietly
  /// show the new one.
  billingAddress  String?
  shippingAddress String?
  paymentTerms    String?
  deliveryTerms   String?

  /// HOW GST APPLIES, decided once from the selling warehouse's
  /// state and the customer's shipping state, then frozen here.
  gstTreatment      SalesGstTreatment
  sellerStateCode   String?
  placeOfSupplyCode String?

  subTotal      Decimal @default(0) @db.Decimal(14, 2)
  /// SUPERSEDED by discountTotal (the sum of line-level discounts).
  /// The step-2 column was a single undifferentiated figure with
  /// no breakdown. Kept, renamed, rather than dropped -- dropping
  /// a column is not an additive migration -- and always zero,
  /// since no sales order existed before step 7.
  legacyDiscount Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableTotal  Decimal @default(0) @db.Decimal(14, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  igstTotal     Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  otherCharges  Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("INR")

  notes String?

  /// WHO APPROVED IT, AND WHEN. Mirrors the purchase order: an
  /// order nobody signed off on reaching the reservation and
  /// dispatch stage is not a control.
  submittedAt  DateTime?
  approvedById String?   @db.Uuid
  approvedAt   DateTime?

  cancelledById String?   @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?

  /// Finished with, short of the full quantity -- the only honest
  /// end for an order partly dispatched and never completing.
  closedById  String?   @db.Uuid
  closedAt    DateTime?
  closeReason String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quotation Quotation?       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  createdBy User             @relation("SoCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?          @relation("SoApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledBy User?          @relation("SoCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  closedBy    User?          @relation("SoClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  lines         SalesOrderLine[]
  invoices      SalesInvoice[]
  deliveryChallans DeliveryChallan[]
  salesReturns  SalesReturn[]

  @@index([customerId])
  @@index([status, orderDate])
  @@index([warehouseId])
  @@index([quotationId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String @id @default(uuid()) @db.Uuid
  salesOrderId String @db.Uuid
  lineNo       Int
  productId    String @db.Uuid

  skuAtOrder  String
  nameAtOrder String
  hsnAtOrder  String?
  description String?

  quantity  Decimal       @db.Decimal(14, 3)
  uom       UnitOfMeasure
  unitPrice Decimal       @db.Decimal(14, 2)
  /// SUPERSEDED by discountAmount/discountPercent below. Kept for
  /// the same reason as SalesOrder.legacyDiscount.
  legacyDiscount Decimal @default(0) @db.Decimal(14, 2)

  /// THE LINE, STEP BY STEP -- the same shape as a purchase order
  /// line, computed by the same money.mjs:
  ///
  ///   grossAmount  = quantity x unitPrice
  ///   discountAmount
  ///   taxableValue = grossAmount - discountAmount
  ///   taxAmount    = taxableValue x taxRate / 100
  ///   lineTotal    = taxableValue + taxAmount
  discountPercent Decimal @default(0) @db.Decimal(6, 3)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  grossAmount     Decimal @default(0) @db.Decimal(14, 2)
  taxableValue    Decimal @default(0) @db.Decimal(14, 2)

  /// The GST rate that applied to THIS line on THIS order, frozen
  /// the same way as on a purchase order line.
  taxRate    Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount Decimal @default(0) @db.Decimal(14, 2)
  igstAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount  Decimal @default(0) @db.Decimal(14, 2)
  lineTotal  Decimal @db.Decimal(14, 2)

  /// RUNNING TOTALS, maintained alongside the ledger entries that
  /// are the real authority.
  ///
  /// reservedQuantity: committed to THIS order and not yet
  /// dispatched. Consumed (reduced) as dispatch releases the
  /// reservation and ships the stock, so reserved + dispatched
  /// is not meaningful as a sum -- dispatching MOVES quantity
  /// from reserved to dispatched, it does not add a third pool.
  ///
  /// dispatchedQuantity: what has actually left the building
  /// against this line.
  ///
  /// returnedQuantity: what has come back, of any disposition.
  /// Counted so eligibility for a further return can be computed
  /// without re-summing every sales return line.
  reservedQuantity   Decimal @default(0) @db.Decimal(14, 3)
  dispatchedQuantity Decimal @default(0) @db.Decimal(14, 3)
  returnedQuantity   Decimal @default(0) @db.Decimal(14, 3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  dispatchLines DeliveryChallanLine[]

  @@unique([salesOrderId, lineNo])
  @@index([productId])
  @@map("sales_order_lines")
}


/* ============================================================
   QUOTATION — NEVER TOUCHES STOCK
   ============================================================

   A quotation is a proposal. Nothing about raising, revising,
   sending or even accepting one changes inventory: no balance is
   written, no ledger row inserted, and quotation.service.mjs does
   not import postStockMovement at all. Only an explicit,
   authorised CONVERSION creates a sales order, and converting is
   never automatic -- creating a quotation never creates an order
   on its own.
   ============================================================ */

model Quotation {
  id            String          @id @default(uuid()) @db.Uuid
  quotationNo   String          @unique
  status        QuotationStatus @default(DRAFT)
  /// Revisions share this: the first quotation in a chain is its
  /// own root, and each later revision points back to the one it
  /// supersedes.
  revisionOf    String?         @db.Uuid
  revisionNo    Int             @default(1)

  customerId  String    @db.Uuid
  warehouseId String?   @db.Uuid

  quotationDate DateTime
  expiryDate    DateTime?

  billingAddress  String?
  shippingAddress String?
  paymentTerms    String?
  deliveryTerms   String?
  notes           String?

  subTotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableTotal  Decimal @default(0) @db.Decimal(14, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  igstTotal     Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("INR")

  sentAt       DateTime?
  respondedAt  DateTime?
  convertedAt  DateTime?
  convertedById String?  @db.Uuid
  cancelledAt  DateTime?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  convertedBy User?            @relation("QuoteConvertedBy", fields: [convertedById], references: [id], onDelete: Restrict)
  previousRevision Quotation?  @relation("QuotationRevision", fields: [revisionOf], references: [id], onDelete: Restrict)
  laterRevisions   Quotation[] @relation("QuotationRevision")
  lines       QuotationLine[]
  salesOrders SalesOrder[]

  @@index([customerId])
  @@index([status, quotationDate])
  @@map("quotations")
}

model QuotationLine {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @db.Uuid
  lineNo      Int
  productId   String @db.Uuid

  skuAtQuote  String
  nameAtQuote String
  hsnAtQuote  String?
  description String?

  quantity  Decimal       @db.Decimal(14, 3)
  uom       UnitOfMeasure
  unitPrice Decimal       @db.Decimal(14, 2)

  discountPercent Decimal @default(0) @db.Decimal(6, 3)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  grossAmount     Decimal @default(0) @db.Decimal(14, 2)
  taxableValue    Decimal @default(0) @db.Decimal(14, 2)

  taxRate    Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount Decimal @default(0) @db.Decimal(14, 2)
  igstAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount  Decimal @default(0) @db.Decimal(14, 2)
  lineTotal  Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quotationId, lineNo])
  @@index([productId])
  @@map("quotation_lines")
}


/* ============================================================
   SALES INVOICE — A CLAIM FOR PAYMENT, NOT A DISPATCH
   ============================================================

   CREATING OR POSTING AN INVOICE MOVES NO STOCK. The chosen
   inventory event is DISPATCH: a delivery challan posting is what
   calls postStockMovement(). sales_invoice.service.mjs does not
   import it. This mirrors the purchase side exactly -- a supplier
   invoice there is likewise not evidence of a goods receipt.

   Price and tax are snapshotted at creation and never
   recalculated from the Product Master, so a later price change
   cannot alter an old invoice.
   ============================================================ */

model SalesInvoice {
  id         String             @id @default(uuid()) @db.Uuid
  invoiceNo  String             @unique
  status     SalesInvoiceStatus @default(DRAFT)

  customerId   String  @db.Uuid
  salesOrderId String? @db.Uuid
  warehouseId  String  @db.Uuid

  invoiceDate DateTime
  dueDate     DateTime?

  billingAddress  String?
  shippingAddress String?
  paymentTerms    String?

  gstTreatment      SalesGstTreatment
  sellerStateCode   String?
  placeOfSupplyCode String?

  subTotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableTotal  Decimal @default(0) @db.Decimal(14, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  igstTotal     Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  otherCharges  Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("INR")

  notes String?

  postedById    String?   @db.Uuid
  postedAt      DateTime?
  cancelledById String?   @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder  SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("InvCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?               @relation("InvPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?               @relation("InvCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines       SalesInvoiceLine[]
  payments    CustomerPayment[]
  deliveryChallans DeliveryChallan[]

  @@index([customerId])
  @@index([salesOrderId])
  @@index([status, invoiceDate])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id             String @id @default(uuid()) @db.Uuid
  salesInvoiceId String @db.Uuid
  lineNo         Int
  productId      String @db.Uuid

  skuAtInvoice  String
  nameAtInvoice String
  hsnAtInvoice  String?

  quantity  Decimal       @db.Decimal(14, 3)
  uom       UnitOfMeasure
  unitPrice Decimal       @db.Decimal(14, 2)

  discountPercent Decimal @default(0) @db.Decimal(6, 3)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  grossAmount     Decimal @default(0) @db.Decimal(14, 2)
  taxableValue    Decimal @default(0) @db.Decimal(14, 2)

  taxRate    Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount Decimal @default(0) @db.Decimal(14, 2)
  igstAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount  Decimal @default(0) @db.Decimal(14, 2)
  lineTotal  Decimal @db.Decimal(14, 2)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesInvoiceId, lineNo])
  @@index([productId])
  @@map("sales_invoice_lines")
}


/* ============================================================
   DELIVERY CHALLAN — THE ONLY SALES DOCUMENT THAT MOVES STOCK
   ============================================================

   Posting one calls postStockMovement() for RESERVATION_RELEASE
   and then OUTWARD, in that order, in one transaction. The order
   matters: releasing first is what keeps
   available = onHand - reserved - damaged
   correct throughout -- releasing after the OUTWARD would let the
   available-stock CHECK see a moment where the same boxes are
   counted as both reserved and gone, and could refuse a dispatch
   that is in fact valid.
   ============================================================ */

model DeliveryChallan {
  id             String                 @id @default(uuid()) @db.Uuid
  challanNo      String                 @unique
  status         DeliveryChallanStatus  @default(DRAFT)

  salesOrderId   String  @db.Uuid
  salesInvoiceId String? @db.Uuid
  customerId     String  @db.Uuid
  warehouseId    String  @db.Uuid

  dispatchDate DateTime

  transporter      String?
  vehicleNumber    String?
  trackingRef      String?
  receiverName     String?
  receiverPhone    String?
  remarks          String?

  dispatchedById String?   @db.Uuid
  dispatchedAt   DateTime?
  cancelledById  String?   @db.Uuid
  cancelledAt    DateTime?
  cancelReason   String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrder   SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice?         @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("DcCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dispatchedBy User?                 @relation("DcDispatchedBy", fields: [dispatchedById], references: [id], onDelete: Restrict)
  cancelledBy  User?                 @relation("DcCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines        DeliveryChallanLine[]

  @@index([salesOrderId])
  @@index([customerId])
  @@index([status, dispatchDate])
  @@map("delivery_challans")
}

model DeliveryChallanLine {
  id                String @id @default(uuid()) @db.Uuid
  deliveryChallanId String @db.Uuid
  lineNo            Int
  salesOrderLineId  String @db.Uuid
  productId         String @db.Uuid

  skuAtDispatch  String
  nameAtDispatch String

  quantity Decimal       @db.Decimal(14, 3)
  uom      UnitOfMeasure

  deliveryChallan DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)
  salesOrderLine  SalesOrderLine  @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([deliveryChallanId, lineNo])
  @@index([salesOrderLineId])
  @@index([productId])
  @@map("delivery_challan_lines")
}


/* ============================================================
   SALES RETURN — STOCK COMING BACK FROM A CUSTOMER
   ============================================================

   Reduces or increases stock through postStockMovement() only,
   and NEVER edits the delivery challan that sent the stock out:
   that entry stays on the ledger and the return sits beside it.

   THREE DISPOSITIONS, and they are not the same movement:

     ACCEPTED_GOOD  INWARD. Back on the shelf, sellable.
     DAMAGED        INWARD, then DAMAGE. In the building, not
                    sellable -- the mirror of a purchase receipt's
                    damaged line.
     REJECTED       NO MOVEMENT AT ALL. The customer's claim is
                    refused outright; nothing was actually
                    returned to the business.
   ============================================================ */

model SalesReturn {
  id       String            @id @default(uuid()) @db.Uuid
  returnNo String            @unique
  status   SalesReturnStatus @default(DRAFT)

  customerId        String  @db.Uuid
  warehouseId       String  @db.Uuid
  salesOrderId      String? @db.Uuid
  salesInvoiceId    String? @db.Uuid
  deliveryChallanId String? @db.Uuid

  returnDate DateTime
  reason     String
  remarks    String?

  receivedById String    @db.Uuid
  postedById   String?   @db.Uuid
  postedAt     DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder?      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  receivedBy      User             @relation("SrReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  postedBy        User?            @relation("SrPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines           SalesReturnLine[]

  @@index([customerId])
  @@index([status, returnDate])
  @@map("sales_returns")
}

model SalesReturnLine {
  id            String             @id @default(uuid()) @db.Uuid
  salesReturnId String             @db.Uuid
  lineNo        Int
  productId     String             @db.Uuid

  skuAtReturn  String
  nameAtReturn String

  quantity    Decimal            @db.Decimal(14, 3)
  uom         UnitOfMeasure
  disposition ReturnDisposition
  remarks     String?

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesReturnId, lineNo])
  @@index([productId])
  @@map("sales_return_lines")
}


/* ============================================================
   CUSTOMER PAYMENT — BASIC TRACKING, NOT ACCOUNTING
   ============================================================
   Every payment names a real, posted invoice. There is no
   "unapplied" payment in this phase: the brief asks for basic
   tracking, not a ledger of customer credit. Balance and status
   are DERIVED from the sum of payments against an invoice, never
   stored redundantly where it could drift from them.
   ============================================================ */

model CustomerPayment {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @db.Uuid
  salesInvoiceId String        @db.Uuid

  amount        Decimal       @db.Decimal(14, 2)
  paymentDate   DateTime
  method        PaymentMethod
  reference     String?
  notes         String?

  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())

  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([salesInvoiceId])
  @@map("customer_payments")
}


// ============================================================
// 9. WAREHOUSE TRANSFERS
// ============================================================

/// Moving stock between the studio's own locations. Posting one
/// writes TWO ledger entries per line — a TRANSFER_OUT at the
/// source and a TRANSFER_IN at the destination — so each
/// warehouse's ledger balances on its own and neither has to know
/// about the other to be read.
///
/// IN_TRANSIT exists because a lorry takes a day. Which warehouse
/// owns the stock while it is on that lorry is an open decision;
/// the schema can express either answer, and the application will
/// decide when the studio does.
model WarehouseTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  transferNo      String         @unique
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  status          TransferStatus @default(DRAFT)

  dispatchedAt DateTime?
  receivedAt   DateTime?
  cancelledAt  DateTime?
  notes        String?

  /// Who sent it and who signed for it. Two different people, on
  /// purpose: a transfer one person can both dispatch and receive
  /// without anybody noticing is not a control.
  dispatchedById String? @db.Uuid
  receivedById   String? @db.Uuid

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fromWarehouse Warehouse               @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse               @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  createdBy     User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  dispatchedBy  User?                   @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: Restrict)
  receivedBy    User?                   @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines         WarehouseTransferLine[]

  @@index([status])
  @@map("warehouse_transfers")
}

model WarehouseTransferLine {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @db.Uuid
  lineNo     Int
  productId  String @db.Uuid

  quantity Decimal       @db.Decimal(14, 3)
  uom      UnitOfMeasure

  /// Running totals across however many receipt events this line
  /// has had. receivedQuantity is what physically arrived --
  /// accepted plus damaged, same convention as a goods receipt
  /// line -- and is NOT the whole story on its own: missing is
  /// dispatched stock that never arrives and never will.
  /// Outstanding (what is still genuinely in transit) is
  /// `quantity - acceptedQuantity - damagedQuantity - missingQuantity`,
  /// enforced by a CHECK constraint, never stored as its own
  /// column that could drift from the three it is derived from.
  acceptedQuantity Decimal @default(0) @db.Decimal(14, 3)
  damagedQuantity  Decimal @default(0) @db.Decimal(14, 3)
  missingQuantity  Decimal @default(0) @db.Decimal(14, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(14, 3)

  transfer WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, lineNo])
  @@index([productId])
  @@map("warehouse_transfer_lines")
}

// ============================================================
// 10. AUDIT
// ============================================================

/// WHO CHANGED WHAT. Append-only, guarded by the same kind of
/// trigger as the stock ledger — an audit trail that can be edited
/// is not an audit trail.
///
/// Deliberately NOT a foreign key to the thing it describes:
/// `entityType` + `entityId` point at any table, and the log has to
/// outlive the row it refers to. A log entry that disappears when
/// the record is deleted documents nothing.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  entityType String
  entityId   String  @db.Uuid
  action     AuditAction

  /// Before and after, for the fields that actually changed. Not
  /// the whole row: a diff is readable, a pair of full snapshots
  /// per edit is not, and it would duplicate every price the studio
  /// has ever set.
  changes Json?

  /// Human-readable summary, for a log a person has to skim.
  summary String?

  actorUserId String?  @db.Uuid
  ipAddress   String?
  /// Ties several log rows to the one request that caused them.
  requestId   String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// 11. INTEGRATION — THE OUTBOX
// ============================================================

/// WHAT THE ERP HAS TO TELL THE OUTSIDE WORLD.
///
/// The transactional outbox pattern. When a price changes, the ERP
/// writes the product AND the event in ONE transaction. So:
///
///   - a change can never be made without its notification being
///     queued, even if the process dies a microsecond later;
///   - a notification can never be sent for a change that rolled
///     back.
///
/// Sending is a separate step that reads this table. That is what
/// makes it safe for the ERP API, and later the Casa De Aurum
/// backend, to be down for an hour without the ERP losing anything.
///
/// Nothing here connects to the website yet. This is the queue that
/// will feed that connection when it is built.
model IntegrationEvent {
  id String @id @default(uuid()) @db.Uuid

  /// "product.updated", "stock.changed", "product.discontinued".
  eventType String
  /// What it is about, by type and id, for the same reason AuditLog
  /// uses a loose reference.
  entityType String
  entityId   String @db.Uuid

  /// The payload AS IT WAS when the change happened. This is the
  /// answer to the open question about retries: re-sending this
  /// re-sends what was agreed at the time, not whatever the row
  /// happens to say now.
  payload Json

  status      IntegrationEventStatus @default(PENDING)
  attempts    Int                    @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  /// When the next retry is due. Lets a worker pick up only what is
  /// actually ready, instead of hammering a failing endpoint.
  nextRetryAt DateTime?
  sentAt      DateTime?

  /// Stops the same change being queued twice by a retried request.
  dedupeKey String @unique

  createdAt DateTime @default(now())

  @@index([status, nextRetryAt])
  @@index([entityType, entityId])
  @@map("integration_events")
}

// ============================================================
// 12. WEBSITE MAPPING  (prepared, not connected)
// ============================================================

/// THE ONLY PLACE THE WEBSITE EXISTS IN THIS DATABASE.
///
/// A side table rather than columns on Product, for three reasons:
///
///   1. the Product Master stays free of another system's
///      identifiers, so the ERP can be read, migrated or rebuilt
///      with the website switched off;
///   2. a product that the website has never heard of simply has no
///      row here — rather than three null columns on every product
///      inviting somebody to read "not synced" as "broken";
///   3. if a second channel is ever added, it is another mapping
///      table, not another five columns on the Product Master.
///
/// NOTHING CONNECTS YET. These fields are prepared so that the
/// integration step is wiring, not a schema change.
model WebsiteProductMapping {
  id String @id @default(uuid()) @db.Uuid

  /// The ERP side. Unique: one product maps to at most one website
  /// product.
  productId String @unique @db.Uuid
  /// The SKU as it was when the mapping was made. A snapshot, so a
  /// mismatch between the two systems can be diagnosed even after
  /// the ERP's own SKU has been corrected.
  skuAtMapping String

  /// The website's own identifier for the same product. Unique, so
  /// two ERP products can never both claim one website listing —
  /// which would make every later push ambiguous.
  externalProductId String? @unique
  /// The website's URL slug, for support staff who have a link and
  /// need the ERP row.
  externalSlug      String?

  syncStatus   SyncStatus @default(NOT_SYNCED)
  lastSyncedAt DateTime?
  lastSyncError String?
  /// Hash of the payload last accepted by the website. Lets the ERP
  /// skip a push when nothing it owns has actually changed, and
  /// detect that the website's copy has drifted.
  lastSyncedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([syncStatus])
  @@map("website_product_mappings")
}

// ============================================================
// 13. DOCUMENT NUMBERING
// ============================================================

/// Gives out PO-2026-0001 and the like without two people getting
/// the same number. The counter is bumped inside the document's own
/// transaction with the row locked; a plain "max + 1" query races
/// the moment two clerks save at once, and a duplicate order number
/// is the kind of error that is noticed a month later by an
/// accountant.
model DocumentSequence {
  /// "PURCHASE_ORDER", "SALES_ORDER", "STOCK_ADJUSTMENT", ...
  documentType String @id
  prefix       String
  /// Reset to zero when this changes, giving PO-2027-0001.
  periodKey    String
  lastNumber   Int    @default(0)
  padding      Int    @default(4)

  updatedAt DateTime @updatedAt

  @@map("document_sequences")
}

// ============================================================
// 14. PRODUCT IMAGES          (added in step 3)
// ============================================================

/// WHERE AN IMAGE CAME FROM. The distinction matters because the
/// catalogue extraction pipeline produces thousands of crops and
/// not one of them is a product image until a person says so.
enum ImageSource {
  /// Uploaded by someone in the studio.
  MANUAL_UPLOAD
  /// Produced by the existing catalogue extraction pipeline.
  /// Arrives unapproved, always.
  CATALOGUE_EXTRACTION
  /// A reference to a page or plate in a supplier's catalogue,
  /// rather than a cut-out of the product itself.
  CATALOGUE_REFERENCE
  /// Somewhere else entirely — a supplier's website, an email.
  EXTERNAL
}

enum ImageRole {
  /// The one picture that represents the variant. At most one per
  /// product, enforced by a partial unique index.
  MAIN
  /// Further pictures of the same variant.
  GALLERY
  /// The catalogue page it was found on, kept for provenance
  /// rather than for display.
  CATALOGUE_PAGE
}

/// A PICTURE OF A VARIANT, AND WHERE IT CAME FROM.
///
/// THE RULE THIS TABLE EXISTS TO ENFORCE: an extracted catalogue
/// image is NOT automatically a product image. The pipeline may
/// write rows here all day; each arrives with isApproved = false
/// and stays out of the Product Master's view of the product until
/// a person approves it. Only an approved image may be MAIN.
///
/// It stores REFERENCES, never files. The catalogue pipeline
/// already uploads to Google Drive and records the URL; this table
/// points at what is already there rather than copying it, so
/// nothing is duplicated and that pipeline is not touched.
model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  /// Where the bytes actually live. A Drive URL, a CDN path, an
  /// object key — whatever the storage of the day is.
  url String
  /// The storage system's own identifier, where it has one. Lets
  /// the image be found again if the URL form ever changes.
  storageRef String?

  role      ImageRole   @default(GALLERY)
  source    ImageSource @default(MANUAL_UPLOAD)
  sortOrder Int         @default(0)
  altText   String?

  /// FALSE UNTIL A PERSON SAYS OTHERWISE. The default is the whole
  /// point: nothing extracted shows up as a product image by
  /// accident.
  isApproved   Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?   @db.Uuid

  /// Provenance, for an image that came out of a catalogue. Which
  /// catalogue, which page — so a questionable picture can be
  /// checked against the original.
  catalogueName String?
  cataloguePage Int?
  /// The extraction pipeline's own reference for this crop. A
  /// loose string, NOT a foreign key: the pipeline is a separate
  /// system with its own storage and this table must not depend on
  /// it being reachable.
  extractionRef String?

  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([productId, role, sortOrder])
  @@index([isApproved])
  @@index([extractionRef])
  @@map("product_images")
}

// ============================================================
// 15. IMPORT         (step 4)
// ============================================================

enum ImportSourceType {
  /// An .xlsx or .csv uploaded by someone in the studio. The only
  /// one verified end to end in this build.
  EXCEL_UPLOAD
  /// The MASTER tab of the catalogue pipeline's Google Sheet.
  /// Implemented against the sheet's real, verified column list,
  /// but NOT tested against a live spreadsheet: no credentials and
  /// no GOOGLE_SHEET_ID are configured in this environment, and
  /// the adapter refuses to run rather than pretend.
  GOOGLE_SHEETS
}

enum ImportBatchStatus {
  CREATED
  READING
  VALIDATING
  PREVIEW_READY
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

/// Does the arithmetic add up?
///
/// A batch is only COMPLETED when every row read has landed in
/// exactly one final category and those add up to the number read.
/// Anything else is FAILED and shows the discrepancy — a batch
/// that silently loses four rows is worse than one that stops.
enum ReconciliationStatus {
  NOT_RUN
  PASSED
  FAILED
  /// The source could not tell us how many rows it had, so "did we
  /// read all of them?" cannot be answered. Stated rather than
  /// assumed.
  UNVERIFIED
}

/// Where one source row ended up. MUTUALLY EXCLUSIVE at the end of
/// a batch: a row is in exactly one of these, which is what makes
/// the reconciliation arithmetic mean anything.
enum ImportRowStatus {
  PENDING
  VALID
  IMPORTED
  /// Already in the ERP, identically. Nothing to do.
  SKIPPED_DUPLICATE
  /// Matched an existing product and was left alone, because this
  /// phase does not overwrite without an approved update rule.
  SKIPPED_EXISTING
  /// Mandatory information missing. Not imported, not discarded.
  INCOMPLETE
  /// Close enough to something that exists that a person must look.
  REVIEW_REQUIRED
  /// Invalid beyond repair — a price that is not a number, a
  /// category that does not exist.
  REJECTED
  /// Tried and failed for a technical reason. Retryable.
  FAILED
}

enum DuplicateClassification {
  NEW_RECORD
  EXISTING_RECORD
  EXACT_DUPLICATE
  POSSIBLE_DUPLICATE
}

/// ONE IMPORT RUN.
///
/// Never deleted. The history of what was loaded, from where, by
/// whom and with what result is part of the catalogue's
/// provenance: "where did this product come from?" has to stay
/// answerable years later.
model ImportBatch {
  id        String           @id @default(uuid()) @db.Uuid
  batchNo   String           @unique
  sourceType ImportSourceType

  /// The uploaded file's name, or the spreadsheet id.
  sourceRef  String
  /// The tab, for a spreadsheet. "MASTER" for the catalogue sheet.
  sourceSheet String?
  /// A hash of the source content where one can be computed, so a
  /// re-upload of the identical file is recognisable as such.
  sourceFingerprint String?

  status         ImportBatchStatus    @default(CREATED)
  reconciliation ReconciliationStatus @default(NOT_RUN)

  /// How many rows the source SAYS it has, where it can say.
  /// Null means it could not tell us, which is why
  /// reconciliation can come back UNVERIFIED rather than PASSED.
  sourceRowsExpected Int?
  sourceRowsRead     Int @default(0)

  // The final tally. Mutually exclusive, and checked.
  rowsValid      Int @default(0)
  rowsImported   Int @default(0)
  rowsDuplicate  Int @default(0)
  rowsExisting   Int @default(0)
  rowsIncomplete Int @default(0)
  rowsReview     Int @default(0)
  rowsRejected   Int @default(0)
  rowsFailed     Int @default(0)
  rowsPending    Int @default(0)
  /// Rows retried at least once. Not a final category — a retried
  /// row still ends up in exactly one of the above.
  rowsRetried    Int @default(0)

  errorSummary String?
  /// The discrepancy, when reconciliation fails. Kept so the
  /// failure can be investigated after the fact.
  reconciliationNote String?

  startedById String?   @db.Uuid
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  startedBy User?       @relation(fields: [startedById], references: [id], onDelete: Restrict)
  rows      ImportRow[]

  @@index([status, startedAt])
  @@index([sourceType])
  @@index([sourceFingerprint])
  @@map("import_batches")
}

/// ONE SOURCE ROW, and what became of it.
///
/// Row-level state is what makes a partially failed batch
/// recoverable: four bad rows out of nine hundred are retried on
/// their own, and nobody re-imports the spreadsheet.
model ImportRow {
  id      String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid

  /// The row's position in the source, 1-based and counting the
  /// header as row 1 — so it matches what the person sees when
  /// they open the file.
  sourceRowNumber Int

  /// A STABLE HASH OF THE ROW'S IDENTIFYING CONTENT.
  ///
  /// Not of the whole row: a changed note or a re-run's new
  /// timestamp would make the same product look new. Built from
  /// the fields that say WHICH product this is, normalised the
  /// same way the duplicate check normalises them.
  ///
  /// Unique per batch, so one batch cannot process a row twice;
  /// across batches it is the key that makes a re-import of the
  /// same sheet a no-op instead of a second copy of the catalogue.
  fingerprint String

  /// The row exactly as it was read, after sanitising. Kept so an
  /// error can be explained against what actually arrived, not
  /// against what the mapper made of it.
  rawData Json

  /// What the mapper made of it. Null where mapping itself failed.
  mappedData Json?

  status         ImportRowStatus         @default(PENDING)
  classification DuplicateClassification?

  /// [{ field, message }] — the same shape every other rejection
  /// in this API uses, so one renderer handles all of them.
  errors Json?

  /// What it matched, and what it became.
  matchedProductId  String? @db.Uuid
  createdProductId  String? @db.Uuid
  createdHeadId     String? @db.Uuid
  createdBrandId    String? @db.Uuid

  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matchedProduct Product?    @relation("ImportRowMatched", fields: [matchedProductId], references: [id], onDelete: Restrict)
  createdProduct Product?    @relation("ImportRowCreated", fields: [createdProductId], references: [id], onDelete: Restrict)

  /// One row number once per batch, and one fingerprint once per
  /// batch. The second is the real guard: a spreadsheet that lists
  /// the same product on two rows is caught at insert.
  @@unique([batchId, sourceRowNumber])
  @@unique([batchId, fingerprint])
  @@index([batchId, status])
  @@index([fingerprint])
  @@map("import_rows")
}
