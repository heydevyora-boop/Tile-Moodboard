// ============================================================
// DE'VYORA / CASA DE AURUM — ERP DATABASE
// ============================================================
//
// THE ERP'S OWN DATABASE. Nothing here reads or writes the Casa De
// Aurum website's database, and nothing in it mirrors the website's
// schema. The two are separate systems that will talk through an
// ERP API later:
//
//     ERP software -> ERP API -> Casa De Aurum backend -> website
//
// The only place the website is acknowledged at all is
// WebsiteProductMapping, which holds the website's identifier for a
// product beside the ERP's own. It is a mapping table on purpose:
// the website's ids never get into the Product Master, so the ERP
// can be read, migrated or rebuilt without the website existing.
//
// ── CONVENTIONS KEPT THROUGHOUT ──────────────────────────────────
//
// IDs are UUIDs, generated by the database, and permanent. A row's
// id is never reused and never changes, so a historical document
// can point at it for ever.
//
// MONEY is Decimal(14,2) and QUANTITY is Decimal(14,3). Never Float.
// A float cannot hold 0.1 exactly, and a stock balance that drifts
// by 0.0000001 per movement is a stock balance nobody can audit.
//
// DELETES ARE RESTRICTED, not cascaded, everywhere that history
// lives. Deleting a brand must not silently take its products, and
// deleting a product must not take the stock movements that explain
// where the stock went. The only cascades in this file are from a
// document to its OWN lines, where the lines have no meaning apart
// from the document.
//
// TIMESTAMPS: createdAt/updatedAt on anything a person edits.
// Append-only tables carry createdAt alone, because there is no
// such thing as updating one.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/erp-client"
}

/// The connection URL is NOT here. Prisma 7 moved it to
/// prisma.config.mjs, where it is read from ERP_DATABASE_URL --
/// a variable of the ERP's own, deliberately not DATABASE_URL, so
/// that having the website's environment loaded in the same shell
/// can never point an ERP migration at the website's database.
datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

/// WHAT A PRODUCT IS, COMMERCIALLY.
///
/// Out of stock is NOT here, deliberately. Whether something is on
/// the shelf is a fact about inventory at a warehouse on a date; it
/// changes several times a week without anybody deciding anything,
/// and it differs per warehouse. Writing it into the product would
/// mean a background job editing the Product Master all day, and
/// two warehouses disagreeing about one column.
///
/// Availability is derived: InventoryBalance.quantityOnHand, or the
/// v_product_availability view.
enum ProductStatus {
  /// On sale. The normal state.
  ACTIVE
  /// Temporarily withdrawn: not offered, not deleted, may return.
  /// The prototype's "Draft" — never yet published — is this plus
  /// a WebsiteProductMapping that has never synced.
  INACTIVE
  /// Retired for good. Never reorder, even at zero stock. This is
  /// the one that must never be confused with "out of stock":
  /// one is a product to buy more of, the other one not to.
  DISCONTINUED
}

/// The unit a quantity is counted in. Tile is bought and sold by
/// the box; area and pieces are properties OF a box, held on the
/// product, so one box is always one box in the ledger.
enum UnitOfMeasure {
  BOX
  PIECE
  SQFT
  SQM
  SET
}

/// WHAT A PRICE IS PER. Tile is quoted per square foot but moved
/// per box, and leaving that implicit is how a 15x error gets into
/// an order. Stated per product, next to the price itself.
enum PriceBasis {
  PER_BOX
  PER_PIECE
  PER_SQFT
  PER_SQM
}

/// Which way stock moved. Transfers are two entries, not one, so
/// each warehouse's own ledger stands on its own.
enum StockMovementType {
  INWARD
  OUTWARD
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_IN
  TRANSFER_OUT
}

/// WHY it moved. Separate from the type because "stock went out"
/// and "stock went out because it broke" answer different
/// questions, and a sales report that counts breakages as sales is
/// worse than no report.
enum StockMovementReason {
  OPENING_STOCK
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  SALES_DISPATCH
  SALES_RETURN
  SAMPLE_ISSUE
  DAMAGE
  STOCK_COUNT_CORRECTION
  WAREHOUSE_TRANSFER
  OTHER
}

/// The kind of document a movement points back to. Stored beside a
/// referenceId so a movement can always be traced to what caused it.
enum StockReferenceType {
  PURCHASE_ORDER
  SALES_ORDER
  STOCK_ADJUSTMENT
  WAREHOUSE_TRANSFER
  OPENING_BALANCE
  MANUAL
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  QUOTATION
  CONFIRMED
  DISPATCHED
  INVOICED
  DELIVERED
  CANCELLED
}

/// A document's life. POSTED is the line past which a document may
/// no longer be edited, because stock has moved on the strength of
/// it: from there a correction is a new document, never an edit.
enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum CustomerType {
  RETAIL
  TRADE
  PROJECT
  INTERNAL
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  CANCEL
  LOGIN
  EXPORT
  IMPORT
}

/// Where a product stands with the website. NOT a product status:
/// a product is perfectly valid without the website ever having
/// heard of it.
enum SyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED
  /// The website changed a field the ERP owns. That is a conflict
  /// for a person to resolve, not an update to accept.
  CONFLICT
}

/// An outbox row's life. The ERP writes the event in the SAME
/// transaction as the business change, so a change can never be
/// made without its notification, nor a notification sent for a
/// change that rolled back.
enum IntegrationEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ============================================================
// 1. PEOPLE AND ACCESS
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  /// Argon2id or bcrypt. Null for an invited account that has not
  /// set one yet. NEVER a plaintext or reversible value.
  passwordHash String?
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?

  /// If the studio later decides one person signs in once for both
  /// systems, this holds the website's user id. Nullable and
  /// unenforced today, because that decision is still open — see
  /// the open questions in ARCHITECTURE.md.
  websiteUserId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles UserRole[]

  // Everything this user is on the record for. All Restrict: an
  // account that posted a stock movement cannot be deleted, because
  // deleting it would orphan the entry that names who did it.
  // Disable the account instead; that is what UserStatus is for.
  createdProducts      Product[]            @relation("ProductCreatedBy")
  updatedProducts      Product[]            @relation("ProductUpdatedBy")
  archivedProducts     Product[]            @relation("ProductArchivedBy")
  uploadedImages       ProductImage[]
  stockEntries         StockLedgerEntry[]
  adjustments          StockAdjustment[]
  importBatches        ImportBatch[]
  purchaseOrders       PurchaseOrder[]
  salesOrders          SalesOrder[]
  transfers            WarehouseTransfer[]
  auditLogs            AuditLog[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// A built-in role the application depends on. Guards against
  /// somebody deleting "Administrator" and locking everyone out.
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId String @db.Uuid
  /// "resource:action", e.g. "product:update", "stock:post".
  /// The same convention the Casa De Aurum backend already uses,
  /// so one mental model covers both systems.
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

// ============================================================
// 2. CATALOGUE MASTER DATA
// ============================================================

model Brand {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    Product[]
  collections Collection[]

  @@index([isActive])
  @@map("brands")
}

/// THE PRODUCT HEAD — ALSO CALLED THE SERIES.
///
/// "Kajaria Neo Sapien". One head, many variants: Grey, Brown and
/// Blue are three Products under this one row, and changing a
/// colour never creates a second head.
///
/// NAMING. The table is `collections` because it was created in
/// step 2, before the term "Product Head" was settled on. The two
/// are the same thing and the API calls it productHead throughout.
/// It was not renamed because renaming a table that already holds
/// data and foreign keys buys nothing the comment does not; say the
/// word and it is one non-destructive ALTER TABLE.
///
/// Scoped to a brand, because that is what a series is in this
/// trade: two brands may both sell something called Verona and they
/// are not the same range.
model Collection {
  id       String  @id @default(uuid()) @db.Uuid
  brandId  String  @db.Uuid
  code     String
  name     String
  /// THE HEAD'S OWN CATEGORY. Added in step 3: a head belongs to a
  /// category, and its variants inherit that unless one genuinely
  /// differs. Nullable because the heads created in step 2 predate
  /// the column, and backfilling a guess would be worse than
  /// leaving the truth — that nobody has said yet.
  categoryId String? @db.Uuid
  description String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([brandId, code])
  @@index([brandId])
  @@index([categoryId])
  @@map("collections")
}

/// Commercial grouping, for buying, reporting and tax. Not the
/// website's idea of a tile's type or best room, which are design
/// facts; this is the ERP's own structure.
model ProductCategory {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  /// Self-reference, so Floor Tiles can hold Large Format Slabs.
  /// Restrict, so a parent with children cannot be deleted out
  /// from under them.
  parentId String? @db.Uuid
  hsnCode  String?
  sortOrder Int    @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  productHeads Collection[]

  @@index([parentId])
  @@map("product_categories")
}

// ============================================================
// 3. PRODUCT MASTER
// ============================================================

model Product {
  /// THE PERMANENT PRODUCT ID. Generated once, never reused, never
  /// changed — not even if the SKU is corrected or the product is
  /// retired. Every historical movement, order line and website
  /// mapping points here, so this id outliving every other fact
  /// about the product is the point of it.
  id String @id @default(uuid()) @db.Uuid

  /// The studio's own code. Unique, and the one humans quote.
  /// Separate from `id` because a SKU is a business decision and
  /// business decisions get corrected; an identity must not.
  sku String @unique

  name String

  brandId      String  @db.Uuid
  categoryId   String  @db.Uuid
  collectionId String? @db.Uuid

  // ── physical description ──────────────────────────────────
  /// As printed on the box, e.g. "600x1200mm".
  size        String
  /// The same size as numbers, so a report can sort and filter by
  /// it. Nullable because an odd-shaped product may not have one.
  lengthMm    Int?
  widthMm     Int?
  thicknessMm Decimal? @db.Decimal(6, 2)
  finish      String?
  colour      String?

  // ── how it is counted ─────────────────────────────────────
  uom            UnitOfMeasure @default(BOX)
  /// What one unit contains. Needed to turn a price per sqft into
  /// the value of a box, which is most of the arithmetic in here.
  piecesPerUnit  Int?
  areaSqftPerUnit Decimal? @db.Decimal(10, 3)

  // ── money ─────────────────────────────────────────────────
  /// Both prices are expressed in `priceBasis`, stated rather than
  /// assumed. Decimal, never Float.
  purchasePrice Decimal    @db.Decimal(14, 2)
  sellingPrice  Decimal    @db.Decimal(14, 2)
  mrp           Decimal?   @db.Decimal(14, 2)
  priceBasis    PriceBasis @default(PER_SQFT)
  /// Overrides the category's code where a product differs.
  hsnCode       String?

  /// Default reorder level. A per-warehouse override lives on
  /// InventoryBalance, for when the studio holds stock in more
  /// than one place.
  reorderLevel Decimal @default(0) @db.Decimal(14, 3)

  /// The MAIN image. Kept in step with the ProductImage row whose
  /// role is MAIN, written in the same transaction — the same
  /// projection pattern as InventoryBalance, and checked the same
  /// way. ProductImage is the source; this is the convenience
  /// pointer the list screens read without a join.
  imageUrl String?

  /// WHAT THIS CATEGORY NEEDS THAT TILES DO NOT.
  ///
  /// A GRC panel has a projection and a material; a tile has a
  /// surface type. Neither belongs as a column on every product in
  /// the catalogue, and adding one per category would mean a
  /// migration every time the studio starts selling something new.
  ///
  /// The keys are not free-form: productRules.mjs declares what
  /// each category requires and permits, and validation rejects a
  /// key no rule allows. A JSON column with no rules behind it is
  /// just a place for typos to accumulate.
  attributes Json?

  status ProductStatus @default(ACTIVE)

  /// ARCHIVED IS NOT A STATUS, AND THAT IS DELIBERATE.
  ///
  /// The three statuses say what the studio has decided
  /// COMMERCIALLY: on sale, withdrawn, retired. Archiving says
  /// something different — "keep this out of my way" — and the two
  /// are independent: a discontinued product may or may not be
  /// archived, and both facts matter.
  ///
  /// It is also why archiving is the answer to "delete this
  /// product". A product with stock history cannot be deleted
  /// without orphaning the movements that explain where the stock
  /// went, and the database refuses. Archiving hides it and keeps
  /// the history.
  archivedAt   DateTime?
  archivedById String?   @db.Uuid

  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand      Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category   ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collection Collection?      @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  createdBy  User?            @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User?            @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy User?            @relation("ProductArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  inventory           InventoryBalance[]
  stockEntries        StockLedgerEntry[]
  adjustmentLines     StockAdjustmentLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  salesOrderLines     SalesOrderLine[]
  transferLines       WarehouseTransferLine[]
  websiteMapping      WebsiteProductMapping?
  images              ProductImage[]
  importRowsMatched   ImportRow[]            @relation("ImportRowMatched")
  importRowsCreated   ImportRow[]            @relation("ImportRowCreated")

  @@index([brandId])
  @@index([categoryId])
  @@index([collectionId])
  @@index([status])
  @@index([name])
  /// The list screen's default view: everything not archived.
  @@index([archivedAt])
  /// Filtering by the variant attributes, which the Product Master
  /// screen offers as four separate filters.
  @@index([colour])
  @@index([finish])
  @@index([size])
  @@map("products")
}

// ============================================================
// 4. WAREHOUSES AND INVENTORY
// ============================================================

model Warehouse {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  /// Exactly one warehouse carries this. The ERP holds stock in one
  /// place today; the schema is already multi-warehouse so that
  /// adding a second is data entry rather than a migration of every
  /// stock figure in the system.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory       InventoryBalance[]
  stockEntries    StockLedgerEntry[]
  adjustments     StockAdjustment[]
  purchaseOrders  PurchaseOrder[]
  salesOrders     SalesOrder[]
  transfersOut    WarehouseTransfer[] @relation("TransferFrom")
  transfersIn     WarehouseTransfer[] @relation("TransferTo")

  @@index([isActive])
  @@map("warehouses")
}

/// WHAT IS ON THE SHELF, PER PRODUCT PER WAREHOUSE.
///
/// This table is a PROJECTION of the stock ledger, not a second
/// source of truth. It exists because summing a product's whole
/// movement history on every page load stops being viable at a few
/// hundred thousand rows — and for nothing else.
///
/// Three things keep it honest:
///
///   1. It is only ever written in the SAME transaction as the
///      ledger entry that caused it. There is no path that moves
///      stock without writing both, and none that writes this
///      without a ledger entry.
///   2. The row is locked (SELECT ... FOR UPDATE) before it is
///      read-modified-written, so two dispatches of the same
///      product at the same instant queue instead of racing. Last
///      writer wins is not an acceptable answer for a stock figure.
///   3. The view v_inventory_reconciliation recomputes every
///      balance from the ledger and reports any row where the two
///      disagree. If this table were ever wrong, that view says so.
///
/// `version` is for optimistic checks in application code on top of
/// the row lock; it also makes a lost update visible after the fact.
model InventoryBalance {
  id          String @id @default(uuid()) @db.Uuid
  productId   String @db.Uuid
  warehouseId String @db.Uuid

  /// Physically present. Never negative — a database CHECK enforces
  /// it, because "we dispatched more than we had" is a data error,
  /// not a number.
  quantityOnHand Decimal @default(0) @db.Decimal(14, 3)
  /// Committed to a confirmed order but not yet dispatched. Whether
  /// confirming an order should reserve at all is still an open
  /// decision; the column exists so that answering it later is not
  /// a migration.
  quantityReserved Decimal @default(0) @db.Decimal(14, 3)

  /// Per-warehouse override of Product.reorderLevel.
  reorderLevel Decimal? @db.Decimal(14, 3)

  lastMovementAt DateTime?
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  /// One balance per product per warehouse. This is what makes the
  /// lock-and-update pattern above safe: there is exactly one row
  /// to lock.
  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

/// THE STOCK LEDGER. APPEND-ONLY.
///
/// Every box that has ever entered or left, and why. This is the
/// source of truth for stock; InventoryBalance above is only a
/// running total of it.
///
/// APPEND-ONLY IS ENFORCED BY THE DATABASE, not by convention.
/// A trigger (see migration 20261120_append_only_guards) raises an
/// exception on any UPDATE or DELETE of this table. It is not a
/// matter of the application being careful: an ORM bug, a console
/// session or a future developer in a hurry all hit the same wall.
///
/// A mistake is corrected by POSTING THE OPPOSITE ENTRY, linked
/// back through `reversalOfEntryId`. The wrong entry stays visible
/// for ever, which is the entire point: a stock history you can
/// quietly edit is a stock history nobody can rely on in a dispute.
model StockLedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  /// A gap-free, monotonically increasing number. Gives the ledger
  /// a total order independent of clocks, so two entries recorded
  /// in the same millisecond still have an unambiguous sequence.
  entryNo BigInt @unique @default(autoincrement())

  productId   String @db.Uuid
  warehouseId String @db.Uuid

  movementType StockMovementType
  reason       StockMovementReason

  /// ALWAYS POSITIVE. The direction lives in movementType, so a
  /// quantity can never be accidentally negated into the wrong
  /// direction. A CHECK constraint enforces the sign.
  quantity Decimal       @db.Decimal(14, 3)
  uom      UnitOfMeasure

  /// Value per unit at the moment it moved, and the line value.
  /// Captured now, whatever valuation method is chosen later:
  /// without a per-movement cost, neither FIFO nor a weighted
  /// average can be computed retrospectively.
  unitCost    Decimal? @db.Decimal(14, 2)
  valueAmount Decimal? @db.Decimal(14, 2)

  /// The running balance AFTER this entry, for this product in this
  /// warehouse. Written inside the same locked transaction, so it
  /// is a fact about the moment rather than a guess, and it is what
  /// lets a stock card be read without re-summing the history.
  balanceAfter Decimal @db.Decimal(14, 3)

  referenceType StockReferenceType
  /// The id of the document that caused this. Not a foreign key:
  /// it points at several different tables by referenceType, and
  /// the whole point of the ledger is that it survives whatever
  /// happens to them.
  referenceId   String? @db.Uuid
  /// The document's human number, copied in as text. Survives even
  /// if the document is later renumbered or removed: a ledger entry
  /// must still be explicable in ten years.
  referenceNo   String?

  /// The business date, which is not always the moment of entry —
  /// a receipt entered on Monday may belong to Saturday.
  transactionDate DateTime
  remarks         String?

  /// PREVENTS ACCIDENTAL DUPLICATES. A caller builds this from what
  /// the movement IS (document, line, action), so a retried API
  /// call, a double-clicked button or a replayed queue message
  /// lands on a unique-constraint violation instead of moving the
  /// stock twice.
  idempotencyKey String @unique

  /// Set on a correcting entry, pointing at the entry it reverses.
  /// The original is never touched.
  reversalOfEntryId String? @db.Uuid

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse  Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy  User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf StockLedgerEntry? @relation("LedgerReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversals  StockLedgerEntry[] @relation("LedgerReversal")

  /// The index a stock card is read by.
  @@index([productId, warehouseId, transactionDate, entryNo])
  /// The index "what did this document move?" is answered by.
  @@index([referenceType, referenceId])
  @@index([warehouseId, transactionDate])
  @@index([reason])
  @@map("stock_ledger_entries")
}

// ============================================================
// 5. STOCK ADJUSTMENTS
// ============================================================

/// A stock count or a written-off breakage, as a document. The
/// adjustment is what a person approves; the ledger entries are
/// what it produces when posted.
model StockAdjustment {
  id            String         @id @default(uuid()) @db.Uuid
  adjustmentNo  String         @unique
  warehouseId   String         @db.Uuid
  reason        StockMovementReason @default(STOCK_COUNT_CORRECTION)
  status        DocumentStatus @default(DRAFT)
  notes         String?

  /// Once posted, stock has moved on the strength of this document
  /// and it becomes read-only. A correction is a new adjustment.
  postedAt    DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines     StockAdjustmentLine[]

  @@index([warehouseId, status])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           String @id @default(uuid()) @db.Uuid
  adjustmentId String @db.Uuid
  lineNo       Int
  productId    String @db.Uuid

  /// What the count found, and what the system thought it held at
  /// the moment of counting. Both are kept: the difference is the
  /// movement, and the two originals are the evidence for it.
  countedQuantity  Decimal @db.Decimal(14, 3)
  expectedQuantity Decimal @db.Decimal(14, 3)
  uom              UnitOfMeasure
  remarks          String?

  /// Cascade is correct here and only here: a line has no meaning
  /// without its document, and a posted document cannot be deleted
  /// at all.
  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, lineNo])
  @@index([productId])
  @@map("stock_adjustment_lines")
}

// ============================================================
// 6. THE PEOPLE ON THE OTHER SIDE
// ============================================================

model Supplier {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique
  name  String
  gstin String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  addressLine  String?
  city         String?
  state        String?
  /// Free text: "30 days", "Advance". Deliberately not an enum —
  /// supplier terms are whatever was negotiated.
  paymentTerms String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("suppliers")
}

model Customer {
  id    String       @id @default(uuid()) @db.Uuid
  code  String       @unique
  name  String
  type  CustomerType @default(RETAIL)
  gstin String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  addressLine  String?
  city         String?
  state        String?
  isActive     Boolean @default(true)

  /// Where this customer came from, if they were created by the
  /// website rather than at the counter. A loose reference, not a
  /// foreign key: the ERP must work with the website switched off.
  websiteCustomerRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrders SalesOrder[]

  @@index([isActive])
  @@index([type])
  @@map("customers")
}

// ============================================================
// 7. PURCHASE
// ============================================================

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  orderNo     String              @unique
  supplierId  String              @db.Uuid
  /// Where the goods are expected to land.
  warehouseId String              @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)

  orderDate    DateTime
  expectedDate DateTime?

  /// Totals are STORED, not computed on read. A supplier's invoice
  /// is a historical fact; recomputing it from today's prices would
  /// quietly rewrite what was agreed.
  subTotal   Decimal @default(0) @db.Decimal(14, 2)
  taxTotal   Decimal @default(0) @db.Decimal(14, 2)
  grandTotal Decimal @default(0) @db.Decimal(14, 2)
  currency   String  @default("INR")

  notes       String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]

  @@index([supplierId])
  @@index([status, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  lineNo          Int
  productId       String @db.Uuid

  /// SNAPSHOTS, taken when the line was written. The product may
  /// later be renamed or re-coded; what was ordered must still read
  /// the way it read on the day. The productId still points at the
  /// live row for anyone who wants today's version.
  skuAtOrder  String
  nameAtOrder String

  quantity         Decimal       @db.Decimal(14, 3)
  uom              UnitOfMeasure
  unitPrice        Decimal       @db.Decimal(14, 2)
  lineTotal        Decimal       @db.Decimal(14, 2)
  /// Running total of what has actually arrived against this line.
  /// Maintained alongside the receipt's ledger entries, which stay
  /// the authority.
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, lineNo])
  @@index([productId])
  @@map("purchase_order_lines")
}

// ============================================================
// 8. SALES
// ============================================================

model SalesOrder {
  id          String           @id @default(uuid()) @db.Uuid
  orderNo     String           @unique
  customerId  String           @db.Uuid
  /// Which warehouse fulfils it. Single-warehouse fulfilment for
  /// now; splitting an order across locations is one of the open
  /// decisions.
  warehouseId String           @db.Uuid
  status      SalesOrderStatus @default(QUOTATION)

  orderDate    DateTime
  dispatchDate DateTime?

  subTotal    Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal @default(0) @db.Decimal(14, 2)
  grandTotal  Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("INR")

  notes       String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines     SalesOrderLine[]

  @@index([customerId])
  @@index([status, orderDate])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String @id @default(uuid()) @db.Uuid
  salesOrderId String @db.Uuid
  lineNo       Int
  productId    String @db.Uuid

  skuAtOrder  String
  nameAtOrder String

  quantity           Decimal       @db.Decimal(14, 3)
  uom                UnitOfMeasure
  unitPrice          Decimal       @db.Decimal(14, 2)
  discount           Decimal       @default(0) @db.Decimal(14, 2)
  lineTotal          Decimal       @db.Decimal(14, 2)
  dispatchedQuantity Decimal       @default(0) @db.Decimal(14, 3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, lineNo])
  @@index([productId])
  @@map("sales_order_lines")
}

// ============================================================
// 9. WAREHOUSE TRANSFERS
// ============================================================

/// Moving stock between the studio's own locations. Posting one
/// writes TWO ledger entries per line — a TRANSFER_OUT at the
/// source and a TRANSFER_IN at the destination — so each
/// warehouse's ledger balances on its own and neither has to know
/// about the other to be read.
///
/// IN_TRANSIT exists because a lorry takes a day. Which warehouse
/// owns the stock while it is on that lorry is an open decision;
/// the schema can express either answer, and the application will
/// decide when the studio does.
model WarehouseTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  transferNo      String         @unique
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  status          TransferStatus @default(DRAFT)

  dispatchedAt DateTime?
  receivedAt   DateTime?
  notes        String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fromWarehouse Warehouse               @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse               @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  createdBy     User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines         WarehouseTransferLine[]

  @@index([status])
  @@map("warehouse_transfers")
}

model WarehouseTransferLine {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @db.Uuid
  lineNo     Int
  productId  String @db.Uuid

  quantity         Decimal       @db.Decimal(14, 3)
  uom              UnitOfMeasure
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 3)

  transfer WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, lineNo])
  @@index([productId])
  @@map("warehouse_transfer_lines")
}

// ============================================================
// 10. AUDIT
// ============================================================

/// WHO CHANGED WHAT. Append-only, guarded by the same kind of
/// trigger as the stock ledger — an audit trail that can be edited
/// is not an audit trail.
///
/// Deliberately NOT a foreign key to the thing it describes:
/// `entityType` + `entityId` point at any table, and the log has to
/// outlive the row it refers to. A log entry that disappears when
/// the record is deleted documents nothing.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  entityType String
  entityId   String  @db.Uuid
  action     AuditAction

  /// Before and after, for the fields that actually changed. Not
  /// the whole row: a diff is readable, a pair of full snapshots
  /// per edit is not, and it would duplicate every price the studio
  /// has ever set.
  changes Json?

  /// Human-readable summary, for a log a person has to skim.
  summary String?

  actorUserId String?  @db.Uuid
  ipAddress   String?
  /// Ties several log rows to the one request that caused them.
  requestId   String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// 11. INTEGRATION — THE OUTBOX
// ============================================================

/// WHAT THE ERP HAS TO TELL THE OUTSIDE WORLD.
///
/// The transactional outbox pattern. When a price changes, the ERP
/// writes the product AND the event in ONE transaction. So:
///
///   - a change can never be made without its notification being
///     queued, even if the process dies a microsecond later;
///   - a notification can never be sent for a change that rolled
///     back.
///
/// Sending is a separate step that reads this table. That is what
/// makes it safe for the ERP API, and later the Casa De Aurum
/// backend, to be down for an hour without the ERP losing anything.
///
/// Nothing here connects to the website yet. This is the queue that
/// will feed that connection when it is built.
model IntegrationEvent {
  id String @id @default(uuid()) @db.Uuid

  /// "product.updated", "stock.changed", "product.discontinued".
  eventType String
  /// What it is about, by type and id, for the same reason AuditLog
  /// uses a loose reference.
  entityType String
  entityId   String @db.Uuid

  /// The payload AS IT WAS when the change happened. This is the
  /// answer to the open question about retries: re-sending this
  /// re-sends what was agreed at the time, not whatever the row
  /// happens to say now.
  payload Json

  status      IntegrationEventStatus @default(PENDING)
  attempts    Int                    @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  /// When the next retry is due. Lets a worker pick up only what is
  /// actually ready, instead of hammering a failing endpoint.
  nextRetryAt DateTime?
  sentAt      DateTime?

  /// Stops the same change being queued twice by a retried request.
  dedupeKey String @unique

  createdAt DateTime @default(now())

  @@index([status, nextRetryAt])
  @@index([entityType, entityId])
  @@map("integration_events")
}

// ============================================================
// 12. WEBSITE MAPPING  (prepared, not connected)
// ============================================================

/// THE ONLY PLACE THE WEBSITE EXISTS IN THIS DATABASE.
///
/// A side table rather than columns on Product, for three reasons:
///
///   1. the Product Master stays free of another system's
///      identifiers, so the ERP can be read, migrated or rebuilt
///      with the website switched off;
///   2. a product that the website has never heard of simply has no
///      row here — rather than three null columns on every product
///      inviting somebody to read "not synced" as "broken";
///   3. if a second channel is ever added, it is another mapping
///      table, not another five columns on the Product Master.
///
/// NOTHING CONNECTS YET. These fields are prepared so that the
/// integration step is wiring, not a schema change.
model WebsiteProductMapping {
  id String @id @default(uuid()) @db.Uuid

  /// The ERP side. Unique: one product maps to at most one website
  /// product.
  productId String @unique @db.Uuid
  /// The SKU as it was when the mapping was made. A snapshot, so a
  /// mismatch between the two systems can be diagnosed even after
  /// the ERP's own SKU has been corrected.
  skuAtMapping String

  /// The website's own identifier for the same product. Unique, so
  /// two ERP products can never both claim one website listing —
  /// which would make every later push ambiguous.
  externalProductId String? @unique
  /// The website's URL slug, for support staff who have a link and
  /// need the ERP row.
  externalSlug      String?

  syncStatus   SyncStatus @default(NOT_SYNCED)
  lastSyncedAt DateTime?
  lastSyncError String?
  /// Hash of the payload last accepted by the website. Lets the ERP
  /// skip a push when nothing it owns has actually changed, and
  /// detect that the website's copy has drifted.
  lastSyncedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([syncStatus])
  @@map("website_product_mappings")
}

// ============================================================
// 13. DOCUMENT NUMBERING
// ============================================================

/// Gives out PO-2026-0001 and the like without two people getting
/// the same number. The counter is bumped inside the document's own
/// transaction with the row locked; a plain "max + 1" query races
/// the moment two clerks save at once, and a duplicate order number
/// is the kind of error that is noticed a month later by an
/// accountant.
model DocumentSequence {
  /// "PURCHASE_ORDER", "SALES_ORDER", "STOCK_ADJUSTMENT", ...
  documentType String @id
  prefix       String
  /// Reset to zero when this changes, giving PO-2027-0001.
  periodKey    String
  lastNumber   Int    @default(0)
  padding      Int    @default(4)

  updatedAt DateTime @updatedAt

  @@map("document_sequences")
}

// ============================================================
// 14. PRODUCT IMAGES          (added in step 3)
// ============================================================

/// WHERE AN IMAGE CAME FROM. The distinction matters because the
/// catalogue extraction pipeline produces thousands of crops and
/// not one of them is a product image until a person says so.
enum ImageSource {
  /// Uploaded by someone in the studio.
  MANUAL_UPLOAD
  /// Produced by the existing catalogue extraction pipeline.
  /// Arrives unapproved, always.
  CATALOGUE_EXTRACTION
  /// A reference to a page or plate in a supplier's catalogue,
  /// rather than a cut-out of the product itself.
  CATALOGUE_REFERENCE
  /// Somewhere else entirely — a supplier's website, an email.
  EXTERNAL
}

enum ImageRole {
  /// The one picture that represents the variant. At most one per
  /// product, enforced by a partial unique index.
  MAIN
  /// Further pictures of the same variant.
  GALLERY
  /// The catalogue page it was found on, kept for provenance
  /// rather than for display.
  CATALOGUE_PAGE
}

/// A PICTURE OF A VARIANT, AND WHERE IT CAME FROM.
///
/// THE RULE THIS TABLE EXISTS TO ENFORCE: an extracted catalogue
/// image is NOT automatically a product image. The pipeline may
/// write rows here all day; each arrives with isApproved = false
/// and stays out of the Product Master's view of the product until
/// a person approves it. Only an approved image may be MAIN.
///
/// It stores REFERENCES, never files. The catalogue pipeline
/// already uploads to Google Drive and records the URL; this table
/// points at what is already there rather than copying it, so
/// nothing is duplicated and that pipeline is not touched.
model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  /// Where the bytes actually live. A Drive URL, a CDN path, an
  /// object key — whatever the storage of the day is.
  url String
  /// The storage system's own identifier, where it has one. Lets
  /// the image be found again if the URL form ever changes.
  storageRef String?

  role      ImageRole   @default(GALLERY)
  source    ImageSource @default(MANUAL_UPLOAD)
  sortOrder Int         @default(0)
  altText   String?

  /// FALSE UNTIL A PERSON SAYS OTHERWISE. The default is the whole
  /// point: nothing extracted shows up as a product image by
  /// accident.
  isApproved   Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?   @db.Uuid

  /// Provenance, for an image that came out of a catalogue. Which
  /// catalogue, which page — so a questionable picture can be
  /// checked against the original.
  catalogueName String?
  cataloguePage Int?
  /// The extraction pipeline's own reference for this crop. A
  /// loose string, NOT a foreign key: the pipeline is a separate
  /// system with its own storage and this table must not depend on
  /// it being reachable.
  extractionRef String?

  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([productId, role, sortOrder])
  @@index([isApproved])
  @@index([extractionRef])
  @@map("product_images")
}

// ============================================================
// 15. IMPORT         (step 4)
// ============================================================

enum ImportSourceType {
  /// An .xlsx or .csv uploaded by someone in the studio. The only
  /// one verified end to end in this build.
  EXCEL_UPLOAD
  /// The MASTER tab of the catalogue pipeline's Google Sheet.
  /// Implemented against the sheet's real, verified column list,
  /// but NOT tested against a live spreadsheet: no credentials and
  /// no GOOGLE_SHEET_ID are configured in this environment, and
  /// the adapter refuses to run rather than pretend.
  GOOGLE_SHEETS
}

enum ImportBatchStatus {
  CREATED
  READING
  VALIDATING
  PREVIEW_READY
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

/// Does the arithmetic add up?
///
/// A batch is only COMPLETED when every row read has landed in
/// exactly one final category and those add up to the number read.
/// Anything else is FAILED and shows the discrepancy — a batch
/// that silently loses four rows is worse than one that stops.
enum ReconciliationStatus {
  NOT_RUN
  PASSED
  FAILED
  /// The source could not tell us how many rows it had, so "did we
  /// read all of them?" cannot be answered. Stated rather than
  /// assumed.
  UNVERIFIED
}

/// Where one source row ended up. MUTUALLY EXCLUSIVE at the end of
/// a batch: a row is in exactly one of these, which is what makes
/// the reconciliation arithmetic mean anything.
enum ImportRowStatus {
  PENDING
  VALID
  IMPORTED
  /// Already in the ERP, identically. Nothing to do.
  SKIPPED_DUPLICATE
  /// Matched an existing product and was left alone, because this
  /// phase does not overwrite without an approved update rule.
  SKIPPED_EXISTING
  /// Mandatory information missing. Not imported, not discarded.
  INCOMPLETE
  /// Close enough to something that exists that a person must look.
  REVIEW_REQUIRED
  /// Invalid beyond repair — a price that is not a number, a
  /// category that does not exist.
  REJECTED
  /// Tried and failed for a technical reason. Retryable.
  FAILED
}

enum DuplicateClassification {
  NEW_RECORD
  EXISTING_RECORD
  EXACT_DUPLICATE
  POSSIBLE_DUPLICATE
}

/// ONE IMPORT RUN.
///
/// Never deleted. The history of what was loaded, from where, by
/// whom and with what result is part of the catalogue's
/// provenance: "where did this product come from?" has to stay
/// answerable years later.
model ImportBatch {
  id        String           @id @default(uuid()) @db.Uuid
  batchNo   String           @unique
  sourceType ImportSourceType

  /// The uploaded file's name, or the spreadsheet id.
  sourceRef  String
  /// The tab, for a spreadsheet. "MASTER" for the catalogue sheet.
  sourceSheet String?
  /// A hash of the source content where one can be computed, so a
  /// re-upload of the identical file is recognisable as such.
  sourceFingerprint String?

  status         ImportBatchStatus    @default(CREATED)
  reconciliation ReconciliationStatus @default(NOT_RUN)

  /// How many rows the source SAYS it has, where it can say.
  /// Null means it could not tell us, which is why
  /// reconciliation can come back UNVERIFIED rather than PASSED.
  sourceRowsExpected Int?
  sourceRowsRead     Int @default(0)

  // The final tally. Mutually exclusive, and checked.
  rowsValid      Int @default(0)
  rowsImported   Int @default(0)
  rowsDuplicate  Int @default(0)
  rowsExisting   Int @default(0)
  rowsIncomplete Int @default(0)
  rowsReview     Int @default(0)
  rowsRejected   Int @default(0)
  rowsFailed     Int @default(0)
  rowsPending    Int @default(0)
  /// Rows retried at least once. Not a final category — a retried
  /// row still ends up in exactly one of the above.
  rowsRetried    Int @default(0)

  errorSummary String?
  /// The discrepancy, when reconciliation fails. Kept so the
  /// failure can be investigated after the fact.
  reconciliationNote String?

  startedById String?   @db.Uuid
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  startedBy User?       @relation(fields: [startedById], references: [id], onDelete: Restrict)
  rows      ImportRow[]

  @@index([status, startedAt])
  @@index([sourceType])
  @@index([sourceFingerprint])
  @@map("import_batches")
}

/// ONE SOURCE ROW, and what became of it.
///
/// Row-level state is what makes a partially failed batch
/// recoverable: four bad rows out of nine hundred are retried on
/// their own, and nobody re-imports the spreadsheet.
model ImportRow {
  id      String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid

  /// The row's position in the source, 1-based and counting the
  /// header as row 1 — so it matches what the person sees when
  /// they open the file.
  sourceRowNumber Int

  /// A STABLE HASH OF THE ROW'S IDENTIFYING CONTENT.
  ///
  /// Not of the whole row: a changed note or a re-run's new
  /// timestamp would make the same product look new. Built from
  /// the fields that say WHICH product this is, normalised the
  /// same way the duplicate check normalises them.
  ///
  /// Unique per batch, so one batch cannot process a row twice;
  /// across batches it is the key that makes a re-import of the
  /// same sheet a no-op instead of a second copy of the catalogue.
  fingerprint String

  /// The row exactly as it was read, after sanitising. Kept so an
  /// error can be explained against what actually arrived, not
  /// against what the mapper made of it.
  rawData Json

  /// What the mapper made of it. Null where mapping itself failed.
  mappedData Json?

  status         ImportRowStatus         @default(PENDING)
  classification DuplicateClassification?

  /// [{ field, message }] — the same shape every other rejection
  /// in this API uses, so one renderer handles all of them.
  errors Json?

  /// What it matched, and what it became.
  matchedProductId  String? @db.Uuid
  createdProductId  String? @db.Uuid
  createdHeadId     String? @db.Uuid
  createdBrandId    String? @db.Uuid

  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matchedProduct Product?    @relation("ImportRowMatched", fields: [matchedProductId], references: [id], onDelete: Restrict)
  createdProduct Product?    @relation("ImportRowCreated", fields: [createdProductId], references: [id], onDelete: Restrict)

  /// One row number once per batch, and one fingerprint once per
  /// batch. The second is the real guard: a spreadsheet that lists
  /// the same product on two rows is caught at insert.
  @@unique([batchId, sourceRowNumber])
  @@unique([batchId, fingerprint])
  @@index([batchId, status])
  @@index([fingerprint])
  @@map("import_rows")
}
