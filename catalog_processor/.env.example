# Casa de Aurum — Python AI service (catalog_processor) environment.
#
#   cp .env.example .env
#
# Loaded via python-dotenv at import time (main_step6_complete.py and
# several app/*.py modules read these with os.getenv()). This service has
# no schema validation like the Node backend's env.ts — a missing var just
# means that specific feature (Gemini call, Drive/Sheets persistence)
# fails at the point it's used, not at boot. AI visualization itself
# already degrades gracefully to LOCAL_ONLY storage if Drive/Sheets aren't
# configured — see visualization_orchestrator.py.

# ============================================================
# GEMINI AI — required for actual AI visualization generation
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# GOOGLE SHEETS / DRIVE — optional, for the MASTER product sheet and
# persisting generated visualizations to Drive. Uses interactive OAuth
# (google_services.py's InstalledAppFlow), NOT the Node backend's
# service-account key — see the note in DEPLOYMENT.md before assuming
# this works headlessly in a container.
# ============================================================
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=CasaDeAurum Tiles
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SPREADSHEET_ID=

# ============================================================
# BACKEND SYNC — makes pen-drive-extracted products usable in mood
# board combinations.
#
# Combination generation on the Node side reads ONLY the Postgres Tile
# table, never Google Sheets/Drive. app/backend_sync.py posts each
# extracted product to the backend's internal /master-sync route so it
# lands in that table too. Leave INTERNAL_SYNC_API_KEY blank and
# extraction still works exactly as before — products reach Sheets and
# Drive, they just won't be available for combinations.
#
# INTERNAL_SYNC_API_KEY must match the same variable in backend/.env.
# ============================================================
# BACKEND_SYNC_URL=http://localhost:5000/api/v1/catalog-extractor/master-sync
INTERNAL_SYNC_API_KEY=

# OAuth client (an "installed app" credential downloaded from Google
# Cloud Console -- NOT the same file as the Node backend's
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH service-account key) and the token
# cache InstalledAppFlow writes after the first interactive login.
# Both default to credentials.json / token.json inside catalog_processor/
# itself, so they're found the same way no matter which directory you
# run a script from. Only set these if you keep the files elsewhere.
# GOOGLE_OAUTH_CREDENTIALS_PATH=credentials.json
# GOOGLE_OAUTH_TOKEN_PATH=token.json
