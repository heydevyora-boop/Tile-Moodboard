generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model Job {
  id            String    @id @default(cuid())
  type          JobType
  status        JobStatus @default(PENDING)
  payload       Json
  result        Json?
  error         String?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  nextAttemptAt DateTime  @default(now())
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
  createdBy     User?     @relation("JobCreatedBy", fields: [createdById], references: [id])

  @@index([type, status])
  @@index([status, nextAttemptAt])
  @@map("jobs")
}

model ApiKey {
  id             String    @id @default(cuid())
  service        String
  label          String
  encryptedValue String
  isActive       Boolean   @default(true)
  lastRotatedAt  DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      User?     @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([service, isActive])
  @@map("api_keys")
}

model LoginAttempt {
  id            String   @id @default(cuid())
  email         String
  userId        String?
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([createdAt])
  @@map("login_attempts")
}

model ErrorLog {
  id         String   @id @default(cuid())
  message    String
  stack      String?
  statusCode Int
  path       String
  method     String
  userId     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([statusCode])
  @@index([createdAt])
  @@map("error_logs")
}

model User {
  id                         String               @id @default(cuid())
  name                       String
  email                      String               @unique
  passwordHash               String
  roleId                     String
  isActive                   Boolean              @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  activityLogs               ActivityLog[]
  apiKeysCreated             ApiKey[]             @relation("ApiKeyCreatedBy")
  catalogsUploaded           Catalog[]            @relation("CatalogUploadedBy")
  favoritesCreated           CustomerFavorite[]   @relation("CustomerFavoriteCreatedBy")
  customersCreated           Customer[]           @relation("CustomerCreatedBy")
  designRulesUpdated         DesignRule[]         @relation("DesignRuleUpdatedBy")
  errorLogs                  ErrorLog[]
  jobsCreated                Job[]                @relation("JobCreatedBy")
  loginAttempts              LoginAttempt[]
  moodBoardsCreated          MoodBoard[]          @relation("MoodBoardCreatedBy")
  moodBoardSharesCreated     MoodBoardShare[]     @relation("MoodBoardShareCreatedBy")
  passwordResetTokens        PasswordResetToken[]
  printBoardTemplatesCreated PrintBoardTemplate[] @relation("PrintBoardTemplateCreatedBy")
  printBoardsCreated         PrintBoard[]         @relation("PrintBoardCreatedBy")
  referenceImages            ReferenceImage[]     @relation("ReferenceImageUploadedBy")
  refreshTokens              RefreshToken[]
  webauthnCredentials        WebAuthnCredential[]
  libraryReferences          LibraryReference[]   @relation("LibraryReferenceUploadedBy")
  ruleVersionsCreated        RuleVersion[]        @relation("RuleVersionCreatedBy")
  settingsUpdated            Setting[]            @relation("SettingUpdatedBy")
  role                       Role                 @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  catalogs  Catalog[]
  tiles     Tile[]

  @@map("brands")
}

model Catalog {
  id                     String        @id @default(cuid())
  brandId                String
  fileName               String
  filePath               String?
  status                 CatalogStatus @default(PENDING)
  totalPages             Int?
  tilesExtracted         Int           @default(0)
  errorMessage           String?
  uploadedById           String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  currentPage            Int?
  fileHash               String?
  duplicateImagesSkipped Int           @default(0)
  duplicateTilesSkipped  Int           @default(0)
  processingLog          String?
  brand                  Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  uploadedBy             User?         @relation("CatalogUploadedBy", fields: [uploadedById], references: [id])
  tiles                  Tile[]

  @@index([brandId])
  @@index([status])
  @@index([brandId, fileHash])
  @@map("catalogs")
}

model Tile {
  id             String             @id @default(cuid())
  name           String
  brandId        String
  catalogId      String?
  size           String?
  finish         String?
  type           TileType           @default(BASE)
  colorTone      String?
  bestRoom       String?
  collection     String?
  imageUrl       String?
  productCode    String?
  inStock        Boolean            @default(true)
  sheetRowRef    Int?
  // Traces imageUrl back to its exact origin in the source catalog PDF
  // (page number + [x0,y0,x1,y1] bbox), so a mismatch can be diagnosed
  // against the original page instead of guessed at.
  sourcePage     Int?
  imageBbox      Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  favoritedBy    CustomerFavorite[]
  moodBoardTiles MoodBoardTile[]
  brand          Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  catalog        Catalog?           @relation(fields: [catalogId], references: [id])

  @@index([brandId])
  @@index([catalogId])
  @@index([type])
  @@index([bestRoom])
  @@map("tiles")
}

model DesignRule {
  id          String      @id @default(cuid())
  section     RuleSection
  key         String?
  title       String
  content     String
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  updatedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  updatedBy   User?       @relation("DesignRuleUpdatedBy", fields: [updatedById], references: [id])

  @@unique([section, key])
  @@map("design_rules")
}

model RuleVersion {
  id            String   @id @default(cuid())
  versionNumber Int      @unique
  fullContent   String
  changeSummary String?
  createdById   String?
  createdAt     DateTime @default(now())
  rulesSnapshot Json
  createdBy     User?    @relation("RuleVersionCreatedBy", fields: [createdById], references: [id])

  @@map("rule_versions")
}

model ReferenceImage {
  id           String   @id @default(cuid())
  styleTag     String
  imageUrl     String
  description  String?
  style        String?
  room         String?
  uploadedById String?
  createdAt    DateTime @default(now())
  thumbnailUrl String?
  uploadedBy   User?    @relation("ReferenceImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([style])
  @@index([room])
  @@map("reference_images")
}

/// DE'VYORA LIBRARY: one curated reference room, under one theme.
///
/// WHAT IT IS FOR, and why it is not the existing ReferenceImage table.
///
/// A client browses this library, picks ONE picture, and that exact
/// picture then does two jobs: the catalog is searched for the tiles
/// that match it, and the scene is generated FROM it. It is a published
/// gallery with a name on each piece.
///
/// `reference_images` is a different thing with a similar name: staff
/// inspiration tagged by style and room, used to seed a theme's own
/// photographs, with no title and nothing published to a client. Putting
/// the two in one table would put every internal upload in front of a
/// customer, so they stay apart. Neither touches the other.
///
/// THE THEME IS NOT A TABLE. The nine themes live in shared/themes.json,
/// which Node and Python both read and which the prompts, the theme
/// check and the tile ranking are all written against. A themes table
/// would be a second source of truth for the same nine rows, and the two
/// would drift. `themeId` holds a theme's own id from that file, and is
/// validated against it on write rather than by a foreign key.
///
/// GOOGLE DRIVE IS THE ONLY STORE. `driveFileId` is required, so a row
/// cannot exist for a picture that is anywhere else -- there is no local
/// path and no blob key in this table to hold one. `imageUrl` is the
/// browser-ready Drive link derived from that id.
model LibraryReference {
  id            String         @id @default(cuid())
  /// A theme id from shared/themes.json: "british", "roman_touch", ...
  themeId       String
  /// What the client sees this room called.
  title         String
  /// Drive link, browser-ready. Derived from driveFileId, never a local path.
  imageUrl      String
  /// The Drive file itself. Required: Drive is the only store there is.
  driveFileId   String         @unique
  /// THE ROOM TYPE, as the second level of the library's hierarchy:
  /// a room id from shared/rooms.json -- "bathroom", "bedroom",
  /// "drawing_room", "powder_room", "kitchen".
  ///
  /// Still `room`, still nullable, and needing no migration. Every row
  /// written before the hierarchy existed has NULL here -- the upload
  /// form only ever sent themeId -- so there is nothing to backfill and
  /// no second column to keep in step with this one.
  ///
  /// Free text an older row happens to carry is resolved by alias at
  /// read time (rooms.service.describeRoom), and anything unrecognised
  /// shows under "Unsorted" rather than being dropped: a picture the
  /// studio uploaded must never become invisible because a category was
  /// added after it.
  room          String?
  description   String?
  /// Unpublished rows stay out of the client's gallery without being deleted.
  isActive      Boolean        @default(true)
  /// The order the studio wants them shown in, within a theme.
  sortOrder     Int            @default(0)
  uploadedById  String?
  /// WHAT THE STUDIO'S EYE READ IN THIS PICTURE.
  ///
  /// A LibraryVisualProfile (backend/src/services/libraryMatch.service.ts):
  /// the palette, the materials, the patterns, the finishes and the mood
  /// one Gemini vision pass found here. It is what the tile-matching step
  /// searches the catalog WITH, so it is read once and kept -- the
  /// picture never changes, so neither does the reading, and a client
  /// generating from the same room twice should not pay for it twice.
  ///
  /// Null means "not read yet", which is not an error: the matcher reads
  /// it on first use. Nothing fails when this column is missing either
  /// (an un-migrated database), it is simply read fresh each time.
  visualProfile Json?
  /// When that reading was taken, so a stale one can be told apart.
  visualReadAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  uploadedBy    User?          @relation("LibraryReferenceUploadedBy", fields: [uploadedById], references: [id])
  wishlistItems WishlistItem[]

  @@index([themeId])
  @@index([themeId, isActive])
  @@index([room])
}

model Customer {
  id             String             @id @default(cuid())
  name           String
  phone          String?
  email          String?
  preferredStyle String?
  preferredRoom  String?
  budget         String?
  notes          String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  favorites      CustomerFavorite[]
  createdBy      User?              @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  moodBoards     MoodBoard[]
  wishlists      ClientWishlist[]

  @@index([phone])
  @@map("customers")
}

model CustomerFavorite {
  id          String   @id @default(cuid())
  customerId  String
  tileId      String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("CustomerFavoriteCreatedBy", fields: [createdById], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tile        Tile     @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@unique([customerId, tileId])
  @@index([customerId])
  @@map("customer_favorites")
}

model MoodBoard {
  id            String          @id @default(cuid())
  customerId    String?
  createdById   String?
  clientBrief   String
  style         String
  room          String
  combinations  Json
  status        MoodBoardStatus @default(GENERATED)
  selectedIndex Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tiles         MoodBoardTile[]
  createdBy     User?           @relation("MoodBoardCreatedBy", fields: [createdById], references: [id])
  customer      Customer?       @relation(fields: [customerId], references: [id])
  printBoards   PrintBoard[]
  share         MoodBoardShare?

  @@index([customerId])
  @@index([status])
  @@map("mood_boards")
}

model MoodBoardTile {
  id               String    @id @default(cuid())
  moodBoardId      String
  tileId           String
  combinationIndex Int
  role             String
  createdAt        DateTime  @default(now())
  moodBoard        MoodBoard @relation(fields: [moodBoardId], references: [id], onDelete: Cascade)
  tile             Tile      @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@unique([moodBoardId, tileId, combinationIndex, role])
  @@map("mood_board_tiles")
}

// A single active share link per board (moodBoardId is @unique — re-sharing
// reuses the same link rather than creating a second one, and staff need to
// be able to re-display/re-copy that same link on demand indefinitely).
// The token is stored as-is rather than hashed like PasswordResetToken --
// deliberately: this is a stable, repeatedly-retrievable "anyone with the
// link can view" URL (the same trust model already used for
// PrintBoard.driveShareUrl / googleDriveClient.generatePublicLink), not a
// single-use secret that only ever needs to be verified once.
model MoodBoardShare {
  id             String                @id @default(cuid())
  moodBoardId    String                @unique
  token          String                @unique
  createdById    String?
  createdAt      DateTime              @default(now())
  respondedAt    DateTime?
  clientResponse ClientResponseStatus?
  moodBoard      MoodBoard             @relation(fields: [moodBoardId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("MoodBoardShareCreatedBy", fields: [createdById], references: [id])

  @@map("mood_board_shares")
}

enum ClientResponseStatus {
  APPROVED
  CHANGES_REQUESTED
}

model PrintBoard {
  id            String          @id @default(cuid())
  moodBoardId   String?
  createdById   String?
  format        PrintFormat
  layout        PrintLayout
  widthValue    Float
  heightValue   Float
  unit          DimensionUnit
  dpi           Int             @default(300)
  fileFormat    PrintFileFormat
  fileUrl       String?
  tilesSnapshot Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  driveFileId   String?
  driveShareUrl String?
  createdBy     User?           @relation("PrintBoardCreatedBy", fields: [createdById], references: [id])
  moodBoard     MoodBoard?      @relation(fields: [moodBoardId], references: [id])

  @@index([moodBoardId])
  @@map("print_boards")
}

model PrintBoardTemplate {
  id          String        @id @default(cuid())
  name        String        @unique
  format      PrintFormat
  layout      PrintLayout
  widthValue  Float
  heightValue Float
  unit        DimensionUnit
  dpi         Int           @default(300)
  createdById String?
  createdAt   DateTime      @default(now())
  createdBy   User?         @relation("PrintBoardTemplateCreatedBy", fields: [createdById], references: [id])

  @@map("print_board_templates")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

/// A passkey: one device's Face ID or fingerprint, enrolled for one user.
///
/// Enrolment only ever happens behind a normal email + password sign-in,
/// and a successful assertion issues the SAME session a password login
/// issues -- this table adds a way IN, never a second kind of session.
///
/// `rpId` is recorded because a credential is bound to the hostname it
/// was created on. A Vercel preview and the production domain are
/// different relying parties, so the same phone legitimately holds a
/// separate credential per host and a login must only consider the ones
/// belonging to the host being asked.
///
/// `passwordTag` is a short hash tag of the user's password hash at the
/// moment of enrolment. Changing the password changes the hash, the tag
/// stops matching, and the passkey is refused with a message telling the
/// owner to set it up again -- so a stolen phone does not outlive a
/// password reset.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  /// Base64url credential id, as the authenticator reports it.
  credentialId String    @unique
  /// Base64url COSE public key. Verification only; nothing secret here.
  publicKey    String
  counter      BigInt    @default(0)
  /// "internal", "hybrid", ... as reported at registration.
  transports   String[]  @default([])
  rpId         String
  passwordTag  String
  /// What the owner will recognise this device as, in their own words.
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rpId])
}

/// A WebAuthn challenge that has already been spent.
///
/// Challenges are signed and carry their own five-minute expiry, which
/// stops a forged one but not a REPLAYED one: a captured sign-in could
/// be sent twice inside that window. Every challenge that verifies is
/// written here first, and a second use of the same one is refused.
///
/// Rows older than the expiry window are dead weight and are swept on
/// use rather than by a job -- there is no scheduler on this deployment.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  /// The challenge itself, base64url, exactly as it was signed.
  challenge String   @unique
  usedAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String?
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("settings")
}

/// WHAT A CLIENT PICKED, AND WHETHER THEY HAVE FINISHED PICKING.
///
/// Identity is the existing Customer: it already has a required name, an
/// optional phone and a created-at, which is the whole of what a
/// registration is. What it does not have is anything about a round of
/// choosing -- a status, a submission time, the Drive folder that round
/// produced -- and those belong to the round, not to the person, because
/// a client can come back next season and choose again.
model ClientWishlist {
  id            String         @id @default(cuid())
  customerId    String
  /// THE CLIENT'S ONLY CREDENTIAL. There is no login here: an
  /// unguessable token in the URL is what proves this browser is the one
  /// that registered, exactly as mood_board_shares.token does for a
  /// shared board. It is never listed and never returned by a lookup
  /// that was not given it.
  token         String         @unique
  /// The short one a person can say out loud across a showroom floor.
  /// Unique, so it can be searched on, and separate from the token
  /// because it is meant to be readable and therefore guessable.
  code          String         @unique
  status        WishlistStatus @default(DRAFT)
  submittedAt   DateTime?
  /// The folder this round's pictures were copied into, once there is
  /// one. Nullable because it is created after submission -- and
  /// because Drive may not have answered when it was.
  driveFolderId String?
  /// WHEN THE CLIENT'S DRIVE FOLDER WAS LAST BROUGHT UP TO DATE, and
  /// what went wrong if it was not. The wishlist is complete in this
  /// database whether or not Drive answered, so a failure is recorded
  /// here to be shown and retried rather than allowed to fail the
  /// submission.
  driveSyncedAt DateTime?
  driveError    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         WishlistItem[]

  @@index([customerId])
  @@index([status])
  @@map("client_wishlists")
}

/// ONE PICTURE A CLIENT HEARTED.
///
/// The picture is REFERENCED, never copied: imageUrl and driveFileId
/// point at the library's own file. What is written down here is the
/// choice itself, plus enough of the picture's identity to still mean
/// something if the library changes underneath it.
model WishlistItem {
  id                 String   @id @default(cuid())
  wishlistId         String
  /// The library's own id for the picture, as the gallery hands it out:
  /// a LibraryReference id, or a shipped starter like
  /// "starter:british-bathroom". Starters are files rather than rows, so
  /// this is a string and not a foreign key -- and it is what the unique
  /// constraint is on, so one client cannot heart one picture twice
  /// whichever kind it is.
  imageId            String
  /// The row behind imageId when there is one. SetNull rather than
  /// Cascade on purpose: a studio deleting a library picture must not
  /// quietly rewrite what a client chose last week.
  libraryReferenceId String?
  /// Drive's own id for the file, kept beside the choice so the record
  /// survives the library row being removed.
  driveFileId        String?
  /// The COPY of this picture in the client's own Drive folder, once
  /// one exists. Set means copied, null means not yet -- which is what
  /// makes a repeated submission copy nothing twice. It never points
  /// at the original, which is only ever read.
  driveCopyId        String?
  themeId            String
  room               String?
  title              String
  imageUrl           String
  createdAt          DateTime @default(now())

  wishlist  ClientWishlist    @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  reference LibraryReference? @relation(fields: [libraryReferenceId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, imageId])
  @@index([wishlistId])
  @@index([themeId])
  @@map("wishlist_items")
}

enum WishlistStatus {
  DRAFT
  SUBMITTED
}

enum CatalogStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TileType {
  BASE
  HIGHLIGHTER
  BORDER
  ACCENT
  LARGE_FORMAT_BASE
}

enum RuleSection {
  GENERAL
  STYLE
  ROOM
  CLIENT
}

enum MoodBoardStatus {
  DRAFT
  GENERATED
  REFINED
  APPROVED
  REJECTED
  ARCHIVED
}

enum PrintFormat {
  CASSETTE_PANEL
  ACP_SIGNBOARD
  MOOD_BOARD_PRINT
  CUSTOM
}

enum PrintLayout {
  HERO_IMAGE
  TILE_GRID
  SIDE_BY_SIDE
  CASSETTE_STYLE
}

enum DimensionUnit {
  FT
  IN
  CM
  MM
}

enum PrintFileFormat {
  PNG
  PDF
}

enum JobType {
  IMAGE_PROCESSING
  EXPORT
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
