# Casa de Aurum backend — local development environment.
#
#   cp .env.example .env
#
# Every variable here is validated by src/config/env.ts on boot (Zod) — the
# app refuses to start with bad/missing values and prints exactly which
# ones. Only DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET are required;
# everything else has a sane default and can be left as-is for local dev.

# ============================================================
# CORE
# ============================================================
NODE_ENV=development
PORT=5000
APP_NAME="Casa de Aurum Internal Tool"
API_PREFIX=/api/v1
BACKEND_PUBLIC_URL=http://localhost:5000

# ============================================================
# DATABASE
# ============================================================
# Local Postgres (docker run -e POSTGRES_PASSWORD=... postgres:16-alpine,
# or your own local install). DIRECT_URL is only read by Prisma's migration
# engine directly (not by src/config/env.ts) — for plain Postgres it's
# identical to DATABASE_URL and can be omitted; only Supabase-style pooled
# connections need it set separately (see DEPLOYMENT.md).
DATABASE_URL=postgresql://casa_de_aurum:devpassword@localhost:5432/casa_de_aurum
# DIRECT_URL=postgresql://casa_de_aurum:devpassword@localhost:5432/casa_de_aurum

# ============================================================
# AUTH
# ============================================================
# Dev-only placeholders — fine to leave as-is locally, but generate real
# random values for anything beyond your own machine:
#   openssl rand -base64 48
JWT_SECRET=dev_only_jwt_secret_change_me_before_anyone_else_uses_this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_before_anyone_else_uses_this
JWT_REFRESH_EXPIRES_IN=30d
# ENCRYPTION_KEY encrypts stored API keys at rest (AES-256-GCM). Optional —
# falls back to a key derived from JWT_SECRET if unset — but set a real one
# outside local dev.
ENCRYPTION_KEY=dev_only_encryption_key_change_me_before_anyone_else_uses_this
PASSWORD_RESET_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# ============================================================
# FRONTEND / CORS
# ============================================================
# Wherever you're actually serving frontend/*.html from during dev
# (e.g. `python3 -m http.server 8080` from the frontend/ directory, or
# nginx via docker compose). Comma-separated for multiple origins.
FRONTEND_URL=http://localhost:8080
PASSWORD_RESET_PATH=/reset-password
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ============================================================
# GOOGLE INTEGRATION (Sheets/Drive) — optional
# ============================================================
# Path to a service account JSON key (see secrets/casadeaurum_key.json).
# Leave unset to run without Drive/Sheets — catalog extraction and AI
# visualization both degrade gracefully (see product_visualization_service.py
# / visualization_orchestrator.py) rather than failing outright.
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/casadeaurum_key.json
GOOGLE_SHEET_NAME=CasaDeAurum Tiles
GOOGLE_DRIVE_ROOT_FOLDER=CasaDeAurum

# ============================================================
# GEMINI AI — optional at boot
# ============================================================
# Can also be set later from Admin -> API Keys once the app is running;
# a DB-stored key always takes priority over this one (GeminiClient.
# resolveApiKey()). Leave unset for local dev if you're not testing AI
# visualization.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=1000
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048

# ============================================================
# PYTHON BRIDGE / AI SERVICE
# ============================================================
PYTHON_EXECUTABLE=python3
# Relative paths below resolve to an absolute path under the backend
# directory automatically — safe to leave relative.
PYTHON_SCRIPTS_DIR=python
PYTHON_AI_BASE_URL=http://127.0.0.1:8000

# ============================================================
# CATALOG / UPLOADS
# ============================================================
CATALOG_UPLOADS_DIR=uploads/catalogs
CATALOG_EXTRACTED_DIR=uploads/extracted-images
CATALOG_MAX_UPLOAD_MB=50
CATALOG_EXTRACTION_CONCURRENCY=2

REFERENCE_IMAGES_DIR=uploads/reference-images
REFERENCE_IMAGE_MAX_MB=10

PRINT_BOARDS_DIR=uploads/print-boards

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_DIR=logs
