# Casa de Aurum backend — production environment.
#
#   cp backend/.env.production.example backend/.env
#
# Fill in every REPLACE_ME below before deploying. See DEPLOYMENT.md at the
# repo root for the full walkthrough (Docker Compose or bare VM + PM2).
# Every variable is validated by src/config/env.ts on boot — the app
# refuses to start with bad/missing values.

# ============================================================
# CORE
# ============================================================
NODE_ENV=production
PORT=5000
APP_NAME="Casa de Aurum Internal Tool"
API_PREFIX=/api/v1
# The public URL this backend is actually reachable at.
BACKEND_PUBLIC_URL=https://REPLACE_ME.example.com

# ============================================================
# DATABASE
# ============================================================
# Bundled Docker Compose Postgres: leave this pointing at the "postgres"
# service — docker-compose.yml resolves POSTGRES_USER/PASSWORD/DB from the
# root-level .env for you, just make sure they match here.
DATABASE_URL=postgresql://postgres.mlhbxrfqgrpelejkfehp:qngR8uLvKGTymP2o@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase (or any pooled Postgres): DATABASE_URL is the pooled connection
# (transaction mode, port 6543, pgbouncer=true) used for normal queries;
# DIRECT_URL is the unpooled connection (port 5432) used only by
# `prisma migrate deploy` — pgbouncer's transaction mode doesn't support
# the prepared statements the migration engine needs. Both require
# sslmode=require. See DEPLOYMENT.md's "Using Supabase" section.
# DATABASE_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME@aws-0-REPLACE_ME.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME@aws-0-REPLACE_ME.pooler.supabase.com:5432/postgres?sslmode=require

# ============================================================
# AUTH — generate real random secrets, one per line:
#   openssl rand -base64 48
# Never reuse the dev placeholders from .env.example in production.
# ============================================================
JWT_SECRET="082f8be714d898d7513e1056b5bca211ff8b70967bd36bad9ea1aad4833545f7794e2d87df48581c16655573d742b54750e73b78c0e277f5e2cf14dde9202ddb"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="4fb3e825264f0b0903217f819713e1294b49031fe88803641485988064a68318a5ae2749c2745f04139bd25d5a27b5f60952f44feab588a3b23cbea7da4901fa"
JWT_REFRESH_EXPIRES_IN=30d
# Encrypts stored API keys at rest (AES-256-GCM). Required in production —
# don't rely on the JWT_SECRET-derived fallback outside local dev.
ENCRYPTION_KEY=REPLACE_ME_RUN_OPENSSL_RAND_BASE64_48
PASSWORD_RESET_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# ============================================================
# FRONTEND / CORS
# ============================================================
# Wherever this is actually being served from (nginx in front of
# frontend/, per docker-compose.yml).
FRONTEND_URL=https://REPLACE_ME.example.com
PASSWORD_RESET_PATH=/reset-password
CORS_ORIGINS=https://REPLACE_ME.example.com

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ============================================================
# GOOGLE INTEGRATION (Sheets/Drive) — optional
# ============================================================
# Mounted read-only into the container at ./secrets:/app/secrets by
# docker-compose.yml — put the service account JSON there first.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/app/secrets/casadeaurum_key.json
GOOGLE_SHEET_NAME=CasaDeAurum Tiles
GOOGLE_DRIVE_ROOT_FOLDER=CasaDeAurum

# ============================================================
# GEMINI AI
# ============================================================
# Can be left unset and configured later from Admin -> API Keys instead —
# a DB-stored key always takes priority over this one at call time.
GEMINI_API_KEY=REPLACE_ME_OR_SET_FROM_ADMIN_UI_AFTER_DEPLOY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=1000
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048

# ============================================================
# PYTHON BRIDGE / AI SERVICE
# ============================================================
PYTHON_EXECUTABLE=python3
PYTHON_SCRIPTS_DIR=python
# The catalog_processor FastAPI service's URL. Docker Compose (this repo's
# docker-compose.yml runs it as its own "catalog_processor" service on the
# same network — use the service name, not localhost, or the backend
# container can't reach it):
PYTHON_AI_BASE_URL=http://catalog_processor:8000
# Bare VM / PM2, both processes on the same host instead: 127.0.0.1:8000

# ============================================================
# CATALOG / UPLOADS
# ============================================================
CATALOG_UPLOADS_DIR=uploads/catalogs
CATALOG_EXTRACTED_DIR=uploads/extracted-images
CATALOG_MAX_UPLOAD_MB=300
CATALOG_EXTRACTION_CONCURRENCY=2

REFERENCE_IMAGES_DIR=uploads/reference-images
REFERENCE_IMAGE_MAX_MB=10

PRINT_BOARDS_DIR=uploads/print-boards

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_DIR=logs
