generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model Job {
  id            String    @id @default(cuid())
  type          JobType
  status        JobStatus @default(PENDING)
  payload       Json
  result        Json?
  error         String?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  nextAttemptAt DateTime  @default(now())
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
  createdBy     User?     @relation("JobCreatedBy", fields: [createdById], references: [id])

  @@index([type, status])
  @@index([status, nextAttemptAt])
  @@map("jobs")
}

model ApiKey {
  id             String    @id @default(cuid())
  service        String
  label          String
  encryptedValue String
  isActive       Boolean   @default(true)
  lastRotatedAt  DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      User?     @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([service, isActive])
  @@map("api_keys")
}

model LoginAttempt {
  id            String   @id @default(cuid())
  email         String
  userId        String?
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([createdAt])
  @@map("login_attempts")
}

model ErrorLog {
  id         String   @id @default(cuid())
  message    String
  stack      String?
  statusCode Int
  path       String
  method     String
  userId     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([statusCode])
  @@index([createdAt])
  @@map("error_logs")
}

model User {
  id                         String               @id @default(cuid())
  name                       String
  email                      String               @unique
  passwordHash               String
  roleId                     String
  isActive                   Boolean              @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  activityLogs               ActivityLog[]
  apiKeysCreated             ApiKey[]             @relation("ApiKeyCreatedBy")
  catalogsUploaded           Catalog[]            @relation("CatalogUploadedBy")
  favoritesCreated           CustomerFavorite[]   @relation("CustomerFavoriteCreatedBy")
  customersCreated           Customer[]           @relation("CustomerCreatedBy")
  designRulesUpdated         DesignRule[]         @relation("DesignRuleUpdatedBy")
  errorLogs                  ErrorLog[]
  jobsCreated                Job[]                @relation("JobCreatedBy")
  loginAttempts              LoginAttempt[]
  moodBoardsCreated          MoodBoard[]          @relation("MoodBoardCreatedBy")
  passwordResetTokens        PasswordResetToken[]
  printBoardTemplatesCreated PrintBoardTemplate[] @relation("PrintBoardTemplateCreatedBy")
  printBoardsCreated         PrintBoard[]         @relation("PrintBoardCreatedBy")
  referenceImages            ReferenceImage[]     @relation("ReferenceImageUploadedBy")
  refreshTokens              RefreshToken[]
  ruleVersionsCreated        RuleVersion[]        @relation("RuleVersionCreatedBy")
  settingsUpdated            Setting[]            @relation("SettingUpdatedBy")
  role                       Role                 @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  catalogs  Catalog[]
  tiles     Tile[]

  @@map("brands")
}

model Catalog {
  id                     String        @id @default(cuid())
  brandId                String
  fileName               String
  filePath               String?
  status                 CatalogStatus @default(PENDING)
  totalPages             Int?
  tilesExtracted         Int           @default(0)
  errorMessage           String?
  uploadedById           String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  currentPage            Int?
  fileHash               String?
  duplicateImagesSkipped Int           @default(0)
  duplicateTilesSkipped  Int           @default(0)
  processingLog          String?
  brand                  Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  uploadedBy             User?         @relation("CatalogUploadedBy", fields: [uploadedById], references: [id])
  tiles                  Tile[]

  @@index([brandId])
  @@index([status])
  @@index([brandId, fileHash])
  @@map("catalogs")
}

model Tile {
  id             String             @id @default(cuid())
  name           String
  brandId        String
  catalogId      String?
  size           String?
  finish         String?
  type           TileType           @default(BASE)
  colorTone      String?
  bestRoom       String?
  collection     String?
  imageUrl       String?
  productCode    String?
  inStock        Boolean            @default(true)
  sheetRowRef    Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  favoritedBy    CustomerFavorite[]
  moodBoardTiles MoodBoardTile[]
  brand          Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  catalog        Catalog?           @relation(fields: [catalogId], references: [id])

  @@index([brandId])
  @@index([catalogId])
  @@index([type])
  @@index([bestRoom])
  @@map("tiles")
}

model DesignRule {
  id          String      @id @default(cuid())
  section     RuleSection
  key         String?
  title       String
  content     String
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  updatedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  updatedBy   User?       @relation("DesignRuleUpdatedBy", fields: [updatedById], references: [id])

  @@unique([section, key])
  @@map("design_rules")
}

model RuleVersion {
  id            String   @id @default(cuid())
  versionNumber Int      @unique
  fullContent   String
  changeSummary String?
  createdById   String?
  createdAt     DateTime @default(now())
  rulesSnapshot Json
  createdBy     User?    @relation("RuleVersionCreatedBy", fields: [createdById], references: [id])

  @@map("rule_versions")
}

model ReferenceImage {
  id           String   @id @default(cuid())
  styleTag     String
  imageUrl     String
  description  String?
  style        String?
  room         String?
  uploadedById String?
  createdAt    DateTime @default(now())
  thumbnailUrl String?
  uploadedBy   User?    @relation("ReferenceImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([style])
  @@index([room])
  @@map("reference_images")
}

model Customer {
  id             String             @id @default(cuid())
  name           String
  phone          String?
  email          String?
  preferredStyle String?
  preferredRoom  String?
  budget         String?
  notes          String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  favorites      CustomerFavorite[]
  createdBy      User?              @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  moodBoards     MoodBoard[]

  @@index([phone])
  @@map("customers")
}

model CustomerFavorite {
  id          String   @id @default(cuid())
  customerId  String
  tileId      String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("CustomerFavoriteCreatedBy", fields: [createdById], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tile        Tile     @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@unique([customerId, tileId])
  @@index([customerId])
  @@map("customer_favorites")
}

model MoodBoard {
  id            String          @id @default(cuid())
  customerId    String?
  createdById   String?
  clientBrief   String
  style         String
  room          String
  combinations  Json
  status        MoodBoardStatus @default(GENERATED)
  selectedIndex Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tiles         MoodBoardTile[]
  createdBy     User?           @relation("MoodBoardCreatedBy", fields: [createdById], references: [id])
  customer      Customer?       @relation(fields: [customerId], references: [id])
  printBoards   PrintBoard[]

  @@index([customerId])
  @@index([status])
  @@map("mood_boards")
}

model MoodBoardTile {
  id               String    @id @default(cuid())
  moodBoardId      String
  tileId           String
  combinationIndex Int
  role             String
  createdAt        DateTime  @default(now())
  moodBoard        MoodBoard @relation(fields: [moodBoardId], references: [id], onDelete: Cascade)
  tile             Tile      @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@unique([moodBoardId, tileId, combinationIndex, role])
  @@map("mood_board_tiles")
}

model PrintBoard {
  id            String          @id @default(cuid())
  moodBoardId   String?
  createdById   String?
  format        PrintFormat
  layout        PrintLayout
  widthValue    Float
  heightValue   Float
  unit          DimensionUnit
  dpi           Int             @default(300)
  fileFormat    PrintFileFormat
  fileUrl       String?
  tilesSnapshot Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  driveFileId   String?
  driveShareUrl String?
  createdBy     User?           @relation("PrintBoardCreatedBy", fields: [createdById], references: [id])
  moodBoard     MoodBoard?      @relation(fields: [moodBoardId], references: [id])

  @@index([moodBoardId])
  @@map("print_boards")
}

model PrintBoardTemplate {
  id          String        @id @default(cuid())
  name        String        @unique
  format      PrintFormat
  layout      PrintLayout
  widthValue  Float
  heightValue Float
  unit        DimensionUnit
  dpi         Int           @default(300)
  createdById String?
  createdAt   DateTime      @default(now())
  createdBy   User?         @relation("PrintBoardTemplateCreatedBy", fields: [createdById], references: [id])

  @@map("print_board_templates")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String?
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("settings")
}

enum CatalogStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TileType {
  BASE
  HIGHLIGHTER
  BORDER
  ACCENT
  LARGE_FORMAT_BASE
}

enum RuleSection {
  GENERAL
  STYLE
  ROOM
  CLIENT
}

enum MoodBoardStatus {
  DRAFT
  GENERATED
  REFINED
  APPROVED
  REJECTED
  ARCHIVED
}

enum PrintFormat {
  CASSETTE_PANEL
  ACP_SIGNBOARD
  MOOD_BOARD_PRINT
  CUSTOM
}

enum PrintLayout {
  HERO_IMAGE
  TILE_GRID
  SIDE_BY_SIDE
  CASSETTE_STYLE
}

enum DimensionUnit {
  FT
  IN
  CM
  MM
}

enum PrintFileFormat {
  PNG
  PDF
}

enum JobType {
  IMAGE_PROCESSING
  EXPORT
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
