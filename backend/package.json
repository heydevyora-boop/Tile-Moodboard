{
  "name": "casa-de-aurum-backend",
  "version": "1.0.0",
  "description": "Internal Catalog & Design Operations Tool — Backend API",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs casa-de-aurum-api",
    "test:gemini": "ts-node -r tsconfig-paths/register test-scripts/gemini_client_test.ts",
    "test:prompt-builder": "ts-node -r tsconfig-paths/register test-scripts/prompt_builder_test.ts",
    "test:print-board": "ts-node -r tsconfig-paths/register test-scripts/print_board_test.ts",
    "test:tile-recommendation": "ts-node -r tsconfig-paths/register test-scripts/tile_recommendation_test.ts",
    "test:print-board-png": "ts-node -r tsconfig-paths/register test-scripts/print_board_png_test.ts",
    "test:google-drive": "ts-node -r tsconfig-paths/register test-scripts/google_drive_test.ts",
    "test:notifications": "node test-scripts/notifications_test.js",
    "test:notifications-wiring": "node test-scripts/notifications_wiring_test.js",
    "test:crypto-secrets": "ts-node -r tsconfig-paths/register test-scripts/crypto_secrets_test.ts",
    "test:admin": "node test-scripts/admin_module_e2e.js",
    "test:api-keys-page": "node test-scripts/api_keys_page_wiring_test.js",
    "test:settings": "node test-scripts/settings_module_e2e.js",
    "test:settings-page": "node test-scripts/settings_page_wiring_test.js",
    "test:logs-page": "node test-scripts/logs_page_wiring_test.js",
    "test:analytics-page": "node test-scripts/analytics_page_wiring_test.js",
    "test:queue-system": "node test-scripts/queue_system_e2e.js",
    "test:customer-page": "node test-scripts/customer_page_wiring_test.js",
    "test:customer": "node test-scripts/customer_module_e2e.js",
    "test:security": "node test-scripts/security_test.js",
    "test:api-docs": "node test-scripts/api_docs_test.js",
    "test:full-pipeline": "node test-scripts/full_pipeline_e2e.js",
    "test:roles-danger-zone": "node test-scripts/roles_and_danger_zone_e2e.js",
    "test:staff-matrix-page": "node test-scripts/staff_matrix_wiring_test.js",
    "test:supabase-readiness": "node test-scripts/supabase_readiness_test.js",
    "test:logging-system": "node test-scripts/logging_system_e2e.js",
    "fix-product-codes": "ts-node prisma/fix-missing-product-codes.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.5",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^174.0.1",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.15",
    "@types/swagger-ui-express": "^4.1.8",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.4",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true
  }
}
