# Read by docker-compose.yml itself (docker compose auto-loads a .env file
# in the same directory as docker-compose.yml). This is separate from
# backend/.env, which holds the application's own configuration.
#
# Copy to .env in this directory and fill in real values before running
# `docker compose up`.

POSTGRES_USER=casa_de_aurum
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
POSTGRES_DB=casa_de_aurum

# Port nginx binds on the host. Change if 80 is already taken, or if a
# reverse proxy/load balancer in front of this stack expects something else.
HTTP_PORT=80
